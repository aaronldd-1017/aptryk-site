        </div>` : ''}
        <div class="sec"><div class="sec-h">Billing</div>
          ${kv('Earns', sel(e.type, TYPES.map(x=>[x,TYPE_T[x]]), `Side.set('${e.id}','type',this.value)`))}
          ${rec ? kv('Per month', inp(e.mrr, `Side.set('${e.id}','mrr',this.value)`, '0'))
                + kv('Renews', dateF(e.renewalAt, `Side.setDate('${e.id}','renewalAt',this.value)`))
                + kv('Per year', `<span class="mono strong">${money(num(e.mrr)*12)}</span>`)
                : kv('Committed', inp(e.budget, `Side.set('${e.id}','budget',this.value)`, '0'))}
        </div>
        <div class="sec">
          <div class="sec-h"><span>Tasks · ${d}/${t.length}</span>
            <button class="btn btn-sm" onclick="Side.addTask('${e.id}')">${I.plus} Add</button></div>
          <div class="mini">${t.length ? t.map(x=>`
            <div class="mini-r ${x.done?'done':''}"><div class="mini-m">
              <span class="tick ${x.done?'on':''}" role="checkbox" aria-checked="${!!x.done}"
                aria-label="Toggle task" onclick="Side.tickTask('${e.id}','${x.id}')">${I.tick}</span>
              <input class="field" value="${esc(x.text)}" placeholder="What needs doing?" aria-label="Task"
                onchange="Side.task('${e.id}','${x.id}',this.value)"/>
            </div><button class="mini-x tip" data-tip="Remove" aria-label="Remove task"
              onclick="Side.delTask('${e.id}','${x.id}')">${I.bin}</button></div>`).join('')
            : nilBox('No tasks yet.')}</div>
        </div>
        <div class="sec">
          <div class="sec-h"><span>Links</span>
            <button class="btn btn-sm" onclick="Side.addLink('${e.id}')">${I.plus} Add</button></div>
          <div class="mini">${(e.links||[]).length ? e.links.map(l=>`
            <div class="mini-r"><div class="mini-m">${I.link}
              <a href="${esc(l.url)}" target="_blank" rel="noopener">${esc(l.label||l.url)}</a></div>
            <button class="mini-x tip" data-tip="Remove" aria-label="Remove link"
              onclick="Side.delLink('${e.id}','${l.id}')">${I.bin}</button></div>`).join('')
            : nilBox('No links yet.')}</div>
        </div>
        <div class="sec"><div class="sec-h">Notes</div>
          <textarea class="area" aria-label="Project notes" placeholder="Scope, decisions, blockers…"
            oninput="Side.note('${e.id}','notes',this.value)">${esc(e.notes||'')}</textarea></div>
      </div>
      ${foot(`${e.stage!=='closed'?`<button class="btn" onclick="Side.stage('${e.id}','${e.stage==='run'?'closed':STAGES[STAGES.indexOf(e.stage)+1]}')">${I.go} Move to ${STAGE_T[e.stage==='run'?'closed':STAGES[STAGES.indexOf(e.stage)+1]]}</button>`:''}
        ${a?`<button class="btn" onclick="App.goTo('clients','${a.id}')">Open client</button>`:''}
        <button class="btn btn-alert" onclick="App.del('work','${e.id}')">${I.bin} Delete</button>`)}`;
  },
  addTask(id){ const e=S.engagements.find(o=>o.id===id); if(!e) return;
    e.tasks=e.tasks||[]; e.tasks.push({id:uid(),text:'',done:false}); App.patch(e,{});
    requestAnimationFrame(()=>{ const f=document.querySelectorAll('#sideIn .mini-r .field');
      const l=f[f.length-1]; if(l) l.focus() }) },
  task(id,t,v){ const e=S.engagements.find(o=>o.id===id); if(!e) return;
    const x=(e.tasks||[]).find(y=>y.id===t); if(!x) return; x.text=v; App.patch(e,{}) },
  tickTask(id,t){ const e=S.engagements.find(o=>o.id===id); if(!e) return;
    const x=(e.tasks||[]).find(y=>y.id===t); if(!x) return; x.done=!x.done; App.patch(e,{}) },
  delTask(id,t){ const e=S.engagements.find(o=>o.id===id); if(!e) return;
    e.tasks=(e.tasks||[]).filter(x=>x.id!==t); App.patch(e,{}) },
  addLink(id){ const e=S.engagements.find(o=>o.id===id); if(!e) return;
    const u=prompt('Link URL (Figma, drive folder, repo…)'); if(!u) return;
    e.links=e.links||[]; e.links.push({id:uid(),url:u,label:prompt('Label (optional)')||u});
    App.patch(e,{}) },
  delLink(id,l){ const e=S.engagements.find(o=>o.id===id); if(!e) return;
    e.links=(e.links||[]).filter(x=>x.id!==l); App.patch(e,{}) },

  lead(l){
    if (!l) return '';
    return `
      <div class="side-h">
        <div class="side-top"><span class="eyebrow">Lead</span>
          ${signalTrack(l)}
          <div class="side-x">
            <button class="act tip" data-tip="More" aria-label="More actions"
              onclick="Menu.forRow(event,'leads','${l.id}')">${I.more}</button>${closeBtn}</div>
        </div>
        <input class="side-title" value="${esc(l.name)}" placeholder="Who is it?" aria-label="Lead name"
          onchange="Side.set('${l.id}','name',this.value)"/>
        <div class="side-sub">${who(l.owner)}<span>${esc(memName(l.owner)||'Unassigned')}</span>
          <span>·</span><span>${esc(l.source||'manual')} · ${ago(l.createdAt)}</span></div>
      </div>
      <div class="side-b">
        <div class="sec"><div class="sec-h">Details</div>
          ${kv('Warmth', sel(l.stage, LEADS.map(x=>[x,LEAD_T[x]]), `Side.set('${l.id}','stage',this.value)`))}
          ${kv('Owner', memSel(l.owner, `Side.set('${l.id}','owner',this.value||null)`))}
          ${kv('Company', inp(l.company, `Side.set('${l.id}','company',this.value)`))}
          ${kv('Email', inp(l.email, `Side.set('${l.id}','email',this.value)`, 'email@company.com'))}
          ${kv('Source', inp(l.source, `Side.set('${l.id}','source',this.value)`, 'inbound, referral, noticed…'))}
        </div>
        <div class="sec"><div class="sec-h">Notes</div>
          <textarea class="area" aria-label="Lead notes" placeholder="What they asked for, budget signals…"
            oninput="Side.note('${l.id}','note',this.value)">${esc(l.note||'')}</textarea></div>
        <div class="sec"><div class="sec-h">Turn into work</div>
          <p class="blurb" style="margin-bottom:12px">Adds the client if they are new, opens a job in Planning, and brings the notes across. The lead is cleared.</p>
          <button class="btn btn-primary" onclick="Side.promote('${l.id}')">${I.go} Turn into work</button></div>
      </div>
      ${foot(`<button class="btn btn-alert" onclick="App.del('leads','${l.id}')">${I.bin} Delete</button>`)}`;
  },
  /* A signal becomes WORK, not just an org. The old model promoted a lead
     into an account and left you to remember to create the project — the
     step that actually mattered. Here the org is created only if it is
     new, and you land in the work with the notes already carried over. */
  promote(id){
    const l = S.leads.find(x=>x.id===id); if(!l) return;
    const orgName = (l.company || l.name || '').trim();
    let org = orgName
      ? S.clients.find(c => (c.name||'').toLowerCase() === orgName.toLowerCase()) : null;
    if (!org && orgName){
      org = { id:uid(), name:orgName, industry:'', tags:['from-lead'],
        owner:l.owner||S.meId, notes:'',
        contacts:(l.email||l.phone)
          ? [{id:uid(),name:l.name||'',role:'',email:l.email||'',phone:l.phone||''}] : [],
        createdAt:now(), updatedAt:now() };
      S.clients.unshift(org);
      log(`<b>${esc(org.name)}</b> added from a lead`, org.id);
    }
    const w = { id:uid(), name:l.name||'Untitled', clientId:org?org.id:null,
      kind:'client', stage:'planning', type:'once', lead:l.owner||S.meId,
      budget:'', mrr:'', renewalAt:null, notes:l.note||'', tasks:[], links:[],
      createdAt:now(), updatedAt:now() };
    S.engagements.unshift(w);
    S.leads = S.leads.filter(x=>x.id!==id);
    log(`Lead turned into work: <b>${esc(w.name)}</b>`, w.id);
    save(); App.goTo('work', w.id);
    toast(org ? `Planning work for ${org.name}` : 'Planning the work');
  },

  payment(m){
    if (!m) return '';
    const inv = S.money.invoices.includes(m);
    const opts = inv ? [['draft','Draft'],['sent','Sent'],['paid','Paid'],['overdue','Overdue']]
                     : [['draft','Draft'],['sent','Sent'],['accepted','Accepted'],['declined','Declined']];
    return `
      <div class="side-h">
        <div class="side-top"><span class="eyebrow">${inv?'Invoice':'Proposal'}</span>
          ${payTrack(m)}
          <div class="side-x">
            <button class="act tip" data-tip="More" aria-label="More actions"
              onclick="Menu.forRow(event,'money','${m.id}')">${I.more}</button>${closeBtn}</div>
        </div>
        <input class="side-title" value="${esc(m.name)}" placeholder="Description" aria-label="Description"
          onchange="Side.set('${m.id}','name',this.value)"/>
        <div class="side-sub"><span class="mono strong">${money(m.amount)}</span>
          <span>·</span><span>${esc(m.client||'No account')}</span></div>
      </div>
      <div class="side-b">
        <div class="sec"><div class="sec-h">Details</div>
          ${kv('Amount', inp(m.amount, `Side.set('${m.id}','amount',this.value)`, '0'))}
          ${kv('Status', sel(m.status, opts, `Side.set('${m.id}','status',this.value)`))}
          ${kv('Account', sel(m.client||'', [['','— none —'],...S.clients.map(c=>[c.name,c.name])],
            `Side.set('${m.id}','client',this.value)`))}
        </div>
        ${!inv && m.status==='accepted' ? `<div class="sec"><div class="sec-h">Next step</div>
          <button class="btn btn-primary" onclick="Side.toInvoice('${m.id}')">${I.go} Convert to invoice</button></div>` : ''}
      </div>
      ${foot(`${inv&&m.status!=='paid'?`<button class="btn" onclick="Side.set('${m.id}','status','paid')">${I.tick} Mark paid</button>`:''}
        <button class="btn btn-alert" onclick="App.del('money','${m.id}')">${I.bin} Delete</button>`)}`;
  },
  toInvoice(id){
    const p = S.money.proposals.find(m=>m.id===id); if(!p) return;
    const v = { ...p, id:uid(), status:'sent', createdAt:now(), updatedAt:now() };
    S.money.invoices.unshift(v);
    log(`Invoice raised from proposal <b>${esc(p.name)}</b>`, v.id);
    save(); App.go('money'); App.setTab('invoices'); App.select(v.id);
    toast('Invoice created');
  },

  reminder(r){
    if (!r) return '';
    return `
      <div class="side-h">
        <div class="side-top"><span class="eyebrow">Reminder</span>
          ${late(r)?`<span class="kind" style="color:var(--alert-txt)">${days(r.due)}d late</span>`:r.done?`<span class="kind">Done</span>`:''}
          <div class="side-x">${closeBtn}</div>
        </div>
        <input class="side-title" value="${esc(r.text)}" placeholder="What needs doing?" aria-label="Reminder"
          onchange="Side.set('${r.id}','text',this.value)"/>
      </div>
      <div class="side-b"><div class="sec"><div class="sec-h">Details</div>
        ${kv('Due', dateF(r.due, `Side.setDate('${r.id}','due',this.value)`))}</div></div>
      ${foot(`<button class="btn" onclick="App.tickRem('${r.id}')">${I.tick} ${r.done?'Reopen':'Mark done'}</button>
        <button class="btn btn-alert" onclick="App.del('reminders','${r.id}')">${I.bin} Delete</button>`)}`;
  },
  note(c){
    if (!c) return '';
    return `
      <div class="side-h">
        <div class="side-top"><span class="eyebrow">Note</span>${c.done?`<span class="kind">Done</span>`:''}
          <div class="side-x">${closeBtn}</div></div>
        <input class="side-title" value="${esc(c.text)}" placeholder="Jot it down" aria-label="Note"
          onchange="Side.set('${c.id}','text',this.value)"/>
        <div class="side-sub">${ago(c.t)}</div>
      </div>
      <div class="side-b"><div class="sec">
        <div class="sec-h">Make it real</div>
        <p class="blurb" style="margin-bottom:12px">If this turns out to matter, start it as our own work. The note text becomes the name and the note is cleared.</p>
        <button class="btn btn-primary" onclick="Side.noteToWork('${c.id}')">${I.go} Turn into work</button>
      </div></div>
      ${foot(`<button class="btn" onclick="App.tickCap('${c.id}')">${I.tick} ${c.done?'Reopen':'Mark done'}</button>
        <button class="btn btn-alert" onclick="App.del('notes','${c.id}')">${I.bin} Delete</button>`)}`;
  },
  /* A lead becomes client work; a note becomes our own. Both intake paths
     end in the same place, which is the point — an idea we had and a job we
     were asked for are the same kind of thing once we commit to it. */
  noteToWork(id){
    const c = S.captures.find(x=>x.id===id); if(!c) return;
    const w = { id:uid(), name:(c.text||'').slice(0,120), clientId:null, kind:'internal',
      stage:'planning', type:'once', lead:S.meId, budget:'', mrr:'', renewalAt:null,
      cadence:'none', checkedAt:null, notes:c.text||'', tasks:[], links:[],
      createdAt:now(), updatedAt:now() };
    S.engagements.unshift(w);
    S.captures = S.captures.filter(x=>x.id!==id);
    log(`Note turned into work: <b>${esc(w.name)}</b>`, w.id,
        {c:'engagements', id:w.id, before:null});
    save(); App.goTo('work', w.id);
    toast('Planning it as our own work');
  },

  logEntry(a){
    if (!a) return '';
    return `
      <div class="side-h">
        <div class="side-top"><span class="eyebrow">Activity</span><div class="side-x">${closeBtn}</div></div>
        <div class="side-title" style="padding-left:0;margin-left:0">${a.label}</div>
        <div class="side-sub">${who(a.who)}<span>${esc(memName(a.who)||'Unknown')}</span>
          <span>·</span><span>${onDate(a.t)}</span></div>
      </div>
      <div class="side-b"><div class="sec">
        <p class="blurb">Activity is a log, so it is not editable. Remove it if it is noise.</p></div></div>
      ${foot(`<button class="btn btn-alert" onclick="App.del('log','${a.id}')">${I.bin} Remove</button>`)}`;
  },
};

/* ─── SETTINGS ───────────────────────────────────────────────────── */
const Settings = {
  html(){
    return `<div class="page-w">
      <div class="block">
        <div class="block-h"><span class="block-t">Appearance</span></div>
        <p class="block-d">A theme is about twenty CSS variables and nothing else — no component in this app contains a literal colour. That is what lets the same build ship to a client as their tool rather than a rebrand of ours.</p>
        <div class="swatches">${Object.entries(THEMES).map(([id,t])=>`
          <button class="swatch ${Theme.id===id?'on':''}" onclick="Theme.set('${id}')"
            aria-label="Use ${esc(t.name)} theme">
            <span class="swatch-p" data-raw>${t.swatch.map(c=>`<i style="background:${c}"></i>`).join('')}</span>
            <span class="swatch-b">${esc(t.name)}${Theme.id===id?I.tick:''}</span>
          </button>`).join('')}</div>
        <div style="margin-top:16px">${kv('Density',
          `<span class="tabs">${Object.entries(DENSITY).map(([id,l])=>
            `<button class="${Theme.density===id?'on':''}" onclick="Theme.setDensity('${id}')">${esc(l)}</button>`).join('')}</span>`)}</div>
      </div>

      <div class="block">
        <div class="block-h"><span class="block-t">Team</span>
          <button class="btn btn-sm" onclick="Settings.addMember()">${I.plus} Add member</button></div>
        <p class="block-d">${Settings.note()}</p>
        <div class="mini">${S.team.map(m=>`
          <div class="mini-r"><div class="mini-m">
            <span class="who">${esc(initials(m.name))}</span>
            <input class="field" value="${esc(m.name)}" aria-label="Member name"
              onchange="Settings.rename('${m.id}',this.value)"/>
            ${m.id===S.meId?`<span class="tag">You</span>`
              :`<button class="btn btn-sm" onclick="Settings.be('${m.id}')">Work as</button>`}
          </div>${S.team.length>1?`<button class="mini-x tip" data-tip="Remove" aria-label="Remove member"
            onclick="Settings.remove('${m.id}')">${I.bin}</button>`:''}</div>`).join('')}</div>
      </div>

      <div class="block">
        <div class="block-h"><span class="block-t">Sync</span>
          <span style="display:flex;gap:8px">
            <button class="btn btn-sm" onclick="Sync.pull(true)">${I.sync} Pull</button>
            <button class="btn btn-sm" onclick="Sync.push()">Push queue</button></span></div>
        ${kv('Status', `<span class="${Sync.state==='fail'?'late':'strong'}">${
          Sync.state==='ok'?'Connected':Sync.state==='fail'?'Offline':'Local only'}</span>`)}
        ${kv('Endpoint', `<span class="quiet">${esc(Sync.base)}</span>`)}
        ${kv('Auth', Sync.sameOrigin
          ? `<span class="strong">Cloudflare Access session</span>`
          : `<span class="late">Shared API key in page source</span>`)}
        ${kv('Queued', `<span class="mono">${Sync.queue.length}</span>`)}
        ${kv('New fields', `<span class="${Sync.extendedFields?'strong':'quiet'}">${Sync.extendedFields?'Syncing':'Held on this device'}</span>`)}
        <p class="block-d" style="margin-top:16px">Owner, project type, MRR, renewal date and contacts stay on this device until the D1 tables have columns for them — sending unknown columns fails the whole batch. Set <span class="mono">Sync.extendedFields = true</span> once the schema is migrated.</p>
      </div>

      <div class="block">
        <div class="block-h"><span class="block-t">About</span></div>
        ${kv('Build', `<span class="mono">${esc(BUILD)}</span>`)}
        ${kv('Client', `<span class="quiet">Desktop. Mobile is a separate app.</span>`)}
        ${kv('Workspace', `<button class="btn btn-sm" onclick="App.go('log')">${I.log} Counts, export and undo live in Log</button>`)}
        ${kv('Shortcuts', `<span class="quiet"><kbd>⌘K</kbd> search · <kbd>⌘N</kbd> new · <kbd>/</kbd> filter · <kbd>↑↓</kbd> move</span>`)}
      </div>
    </div>`;
  },
  /* Say plainly which mode the workspace is in — one is verified identity,
     the other is an honour system, and the difference matters. */
  note() {
    return Identity.resolved
      ? `Signed in as <strong>${esc(Identity.resolved.email)}</strong>, verified by Cloudflare Access. Edits are credited to you automatically.`
      : `Not behind Access, so attribution is self-declared — whoever this browser is set to gets the credit. Put the app behind Access and it becomes automatic.`;
  },
  addMember(){ S.team.push({id:uid(),name:'New member',email:''}); save(); App.render() },
  rename(id,v){ const m=mem(id); if(!m) return; m.name=v; save(); App.render() },
  be(id){ S.meId=id; save(); App.render(); toast('Now working as '+memName(id)) },
  async remove(id){
    if (S.team.length<=1) return;
    if (!await Dialog.ask('Remove '+memName(id)+'?',
      'Records they own become unassigned. Nothing else is deleted.','Remove')) return;
    S.team = S.team.filter(m=>m.id!==id);
    S.clients.forEach(c=>{ if(c.owner===id) c.owner=null });
    S.engagements.forEach(e=>{ if(e.lead===id) e.lead=null });
    S.leads.forEach(l=>{ if(l.owner===id) l.owner=null });
    if (S.meId===id) S.meId=S.team[0].id;
    save(); App.render();
  },
  async wipe(){
    if (!await Dialog.ask('Clear local data?',
      'This empties this browser only. Anything already synced returns on the next pull.','Clear')) return;
    localStorage.removeItem(KEY); location.reload();
  },
};

const BUILD = 'crm-8.2 · desktop';

try { App.boot(); console.info('APTRYK ' + BUILD) }
catch (err) {
  console.error(err);
  document.body.innerHTML = `<div style="padding:48px;font-family:system-ui">
    <h1 style="font-size:22px;margin-bottom:10px">The app failed to start</h1>
    <p style="opacity:.7;max-width:60ch;line-height:1.6">Your data is untouched in local storage.
    Error: <code>${esc(err && err.message)}</code></p></div>`;
}
</script>
