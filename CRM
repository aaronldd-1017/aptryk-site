/* ─── THEME ──────────────────────────────────────────────────────── */
const THEMES = {
  aptryk: { name:'Aptryk', note:'House theme', swatch:['#171A21','#21252E','#4A7CF5','#ECEFF7'] },
  light:  { name:'Light',  note:'Same components, inverted', swatch:['#FBFBFD','#FFFFFF','#3560DC','#12151C'] },
};
const DENSITY = { default:'Default', compact:'Compact' };
const Theme = {
  get id(){ return localStorage.getItem('aptryk:theme') || 'aptryk' },
  get density(){ return localStorage.getItem('aptryk:density') || 'default' },
  set(id){ if(!THEMES[id]) return; localStorage.setItem('aptryk:theme',id);
    document.body.dataset.theme = id; App.render(); toast(THEMES[id].name+' theme') },
  setDensity(d){ if(!DENSITY[d]) return; localStorage.setItem('aptryk:density',d);
    document.body.dataset.density = d; App.render() },
  apply(){ document.body.dataset.theme = this.id; document.body.dataset.density = this.density },
};

/* ─── MENU ───────────────────────────────────────────────────────────
   The discoverable home for secondary and destructive actions. Law 5:
   nothing lives only behind a keystroke. */
const Menu = {
  open(x,y,items){
    const m = $('#menu');
    m.innerHTML = items.map(i => i.hr ? '<hr/>' : i.head
      ? `<div class="menu-h">${esc(i.label)}</div>`
      : `<button class="${i.bad?'bad':''}" data-i="${i.id}">${i.icon||''}<span>${esc(i.label)}</span></button>`).join('');
    m.classList.add('on');
    const r = m.getBoundingClientRect();
    m.style.left = Math.min(x, innerWidth - r.width - 8) + 'px';
    m.style.top = Math.min(y, innerHeight - r.height - 8) + 'px';
    m.querySelectorAll('[data-i]').forEach(b => b.onclick = () => {
      const it = items.find(i => i.id === b.dataset.i); this.close(); if (it && it.run) it.run() });
    setTimeout(() => document.addEventListener('mousedown', e => {
      if (!m.contains(e.target)) this.close() }, { once:true }), 0);
  },
  close(){ $('#menu').classList.remove('on') },

  forRow(ev, kind, id){
    ev.stopPropagation();
    const r = ev.currentTarget.getBoundingClientRect();
    const it = [{ id:'open', label:'Open', icon:I.pen, run:()=>App.open(id) }];
    if (kind==='clients'){
      it.push({ id:'nw', label:'Start work for this client', icon:I.plus, run:()=>Side.newWork(id) },
              { hr:1 }, { head:1, label:'Belongs to' });
      S.team.forEach(m => it.push({ id:'o'+m.id, label:m.name, icon:I.user,
        run:()=>{ const c=acct(id); App.patch(c,{owner:m.id},
          `<b>${esc(c.name)}</b> assigned to ${esc(m.name)}`, 'clients') } }));
    }
    if (kind==='work'){
      const e = V.work.find(id);
      it.push({ hr:1 }, { head:1, label:'Move to' });
      STAGES.forEach(s2 => { if (e && e.stage===s2) return;
        it.push({ id:'s'+s2, label:STAGE_T[s2], run:()=>Side.stage(id,s2) }) });
      if (e && e.stage==='running')
        it.push({ hr:1 }, { id:'chk', label:'Log a check-in', icon:I.tick,
          run:()=>Side.check(id) });
      it.push({ hr:1 }, { id:'kind',
        label: e && e.kind==='internal' ? 'Mark as client work' : 'Mark as our own work',
        run:()=>App.patch(e,{kind: e.kind==='internal'?'client':'internal'}) });
    }
    if (kind==='leads'){
      it.push({ id:'pr', label:'Turn into work', icon:I.go, run:()=>Side.promote(id) },
              { hr:1 }, { head:1, label:'Warmth' });
      LEADS.forEach(s2 => it.push({ id:'l'+s2, label:LEAD_T[s2],
        run:()=>App.patch(V.leads.find(id),{stage:s2}) }));
    }
    if (kind==='money'){
      const m = V.money.find(id);
      if (m && S.money.proposals.includes(m))
        it.push({ id:'iv', label:'Turn into invoice', icon:I.go, run:()=>Side.toInvoice(id) });
      if (m && S.money.invoices.includes(m) && m.status!=='paid')
        it.push({ id:'pd', label:'Mark paid', icon:I.tick, run:()=>Side.set(id,'status','paid') });
    }
    if (kind==='reminders') it.push({ id:'t', label:'Toggle done', icon:I.tick, run:()=>App.tickRem(id) });
    if (kind==='notes') it.push(
      { id:'nw', label:'Turn into work', icon:I.go, run:()=>Side.noteToWork(id) },
      { id:'t', label:'Toggle done', icon:I.tick, run:()=>App.tickCap(id) });
    it.push({ hr:1 }, { id:'del', label:'Delete', icon:I.bin, bad:1,
      run:()=>App.del(kind, id) });
    this.open(r.right - 190, r.bottom + 6, it);
  },
};

/* ─── APP ────────────────────────────────────────────────────────── */
const App = {
  view:'now', sel:{}, q:'', tab:'all', tabBy:{}, sortBy:{}, dir:{}, filter:null,

  boot(){
    Theme.apply(); load(); Sync.seed();
    if (localStorage.getItem('aptryk:rail')) $('#app').classList.add('rail');
    this.railIcon();
    this.go(location.hash.slice(1) || 'now', true);
    Sync.start(); Keys.bind(); Grip.bind();
    Identity.claim();          // no-op unless the app is behind Access
    addEventListener('hashchange', () => { const v = location.hash.slice(1);
      if (v && V[v] && v !== this.view) this.go(v) });
  },

  go(view, replace){
    if (!V[view]) view = 'now';
    this.view = view; this.q = ''; this.filter = null;
    const s = V[view];
    this.tab = this.tabBy[view] || (s.tabs ? s.tabs[0][0] : 'all');
    if (replace) history.replaceState(null,'','#'+view);
    else if (location.hash.slice(1) !== view) history.pushState(null,'','#'+view);
    this.render();
    const r = $('#rows'); if (r) r.scrollTop = 0;
  },
  goTo(view, id){ this.go(view); this.select(id) },
  setTab(t){ this.tab=t; this.tabBy[this.view]=t; this.sel[this.view]=null; this.filter=null; this.render() },
  select(id){ this.sel[this.view]=id; this.render() },
  open(id){ this.select(id);
    requestAnimationFrame(()=>{ const t=$('#sideIn .side-title'); if(t){t.focus(); t.select&&t.select()} }) },
  cur(){ const s=V[this.view], id=this.sel[this.view]; return id&&s.find ? s.find(id) : null },
  setFilter(f){ this.filter = this.filter===f ? null : f; this.sel[this.view]=null; this.render() },
  sort(k){ const v=this.view;
    if (this.sortBy[v]===k) this.dir[v] = this.dir[v]==='asc'?'desc':'asc';
    else { this.sortBy[v]=k; this.dir[v]='asc' }
    this.render() },

  rows(){
    const s = V[this.view];
    if (!s.rows) return [];
    let l = s.rows();
    if (this.filter && s.filters && s.filters[this.filter])
      l = l.filter(o => o.group || s.filters[this.filter](o));
    const q = this.q.trim().toLowerCase();
    if (q) l = l.filter(o => o.group || [o.name,o.what,o.text,o.why,o.company,o.client,
      o.source, acctName(o), memName(o.owner ?? o.lead)]
      .filter(Boolean).join(' ').toLowerCase().includes(q));
    l = l.filter((o,i) => !o.group || (l[i+1] && !l[i+1].group));
    const k = this.sortBy[this.view] || s.defSort;
    const grouped = typeof s.grouped === 'function' ? s.grouped() : !!s.grouped;
    if (k && s.sorts && s.sorts[k] && !grouped){
      l = [...l].sort(s.sorts[k]);
      if (this.dir[this.view]==='desc') l.reverse();
    }
    return l;
  },

  render(){
    const s = V[this.view], app = $('#app'), isPage = !!s.page;
    this.nav();
    ['tools','cols','rows','sum'].forEach(i => $('#'+i).hidden = isPage);
    $('#page').hidden = !isPage;
    $('#newBtn').style.display = (isPage || s.noCreate) ? 'none' : '';
    $('#newTxt').textContent = s.noun ? 'New ' + s.noun : 'New';

    $('#head').innerHTML = `<div class="title">${esc(s.t)}</div>` +
      (s.blurb ? `<div class="blurb">${esc(s.blurb)}</div>` : '');

    if (isPage){ $('#page').innerHTML = s.page(); app.classList.add('solo');
      this.foot(0); return }

    const list = this.rows(), real = list.filter(o=>!o.group);

    if (s.metrics) $('#head').insertAdjacentHTML('beforeend',
      `<div class="metrics">${s.metrics(real).map(m=>
        m.f ? `<button class="metric ${this.filter===m.f?'on':''}"
                 onclick="App.setFilter('${m.f}')" aria-label="Filter by ${esc(m.k)}">
                 <div class="metric-k">${esc(m.k)}</div>
                 <div class="metric-v ${m.tone||''}">${esc(String(m.v))}</div></button>`
            : `<div class="metric"><div class="metric-k">${esc(m.k)}</div>
                 <div class="metric-v ${m.tone||''}">${esc(String(m.v))}</div></div>`).join('')}</div>`);

    $('#tools').innerHTML = `
      <div class="find">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input class="field" id="q" placeholder="Search ${esc(s.t.toLowerCase())}" value="${esc(this.q)}"
          aria-label="Search ${esc(s.t.toLowerCase())}" autocomplete="off" spellcheck="false"/>
      </div>
      ${s.tabs ? `<div class="tabs">${s.tabs.map(([v,l])=>
        `<button class="${this.tab===v?'on':''}" onclick="App.setTab('${v}')">${esc(l)}</button>`).join('')}</div>` : ''}
      ${this.filter ? `<button class="btn btn-sm" onclick="App.setFilter('${this.filter}')">${I.x} Clear filter</button>` : ''}
      <div class="tools-gap"></div>
      ${s.tools ? s.tools() : ''}
      ${s.make ? `<button class="btn" onclick="App.create()">${I.plus} Add ${esc(s.noun||'item')}</button>` : ''}
      <button class="btn btn-ico tip" data-tip="Refresh" aria-label="Refresh from server"
        onclick="Sync.pull(true)">${I.sync}</button>`;

    $('#cols').style.gridTemplateColumns = s.cols;
    $('#sum').style.gridTemplateColumns = s.cols;
    const sk = this.sortBy[this.view] || s.defSort;
    $('#cols').innerHTML = s.head.map(h => `<div class="${h.n?'num':''}">${
      h.s ? `<button class="${sk===h.s?'on':''}" onclick="App.sort('${h.s}')">${esc(h.t)}${
        sk===h.s ? (this.dir[this.view]==='desc'?I.up:I.down) : ''}</button>` : esc(h.t)}</div>`).join('');

    const cur = this.sel[this.view];
    if (!real.length){
      $('#rows').innerHTML = `<div class="void">${s.nil.i}<h3>${esc(s.nil.h)}</h3>
        <p>${esc(s.nil.p)}</p>
        ${s.make ? `<button class="btn btn-primary" onclick="App.create()">${I.plus} Add ${esc(s.noun||'item')}</button>` : ''}
        ${this.q||this.filter ? `<button class="btn btn-quiet" onclick="App.clear()">Clear search</button>` : ''}</div>`;
      $('#sum').innerHTML = '';
    } else {
      $('#rows').innerHTML = list.map(o => o.group
        ? `<div class="group"><div class="group-t">${esc(o.label)}<span class="tag">${o.n}</span>
             ${o.note?`<span class="group-n">${esc(o.note)}</span>`:''}</div>
           <span class="mono">${o.val?money(o.val):''}</span></div>`
        : `<div class="row ${o.id===cur?'on':''} ${s.flag&&s.flag(o)?'due':''}" role="button" tabindex="0"
             style="grid-template-columns:${s.cols}" data-id="${o.id}"
             onclick="App.select('${o.id}')"
             onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();App.open('${o.id}')}"
             oncontextmenu="event.preventDefault();this.blur();Menu.forRow(event,'${this.view}','${o.id}')"
           >${s.cell(o).map((c,i)=>`<div class="cell ${s.head[i]&&s.head[i].n?'num':''}">${c}</div>`).join('')}</div>`).join('');
      $('#sum').innerHTML = s.sum
        ? s.sum(real).map((c,i)=>`<div class="${s.head[i]&&s.head[i].n?'num':''}">${c}</div>`).join('') : '';
    }

    const rec = this.cur();
    // No selection means no side pane. An empty 400px column is a hole,
    // not a layout.
    app.classList.toggle('solo', !rec);
    $('#sideIn').innerHTML = rec ? s.side(rec) : '';
    this.foot(real.length);
  },

  nav(){
    const g = {};
    VK.forEach(k => (g[V[k].grp] ||= []).push(k));
    $('#nav').innerHTML = Object.entries(g).map(([name,keys]) => `
      <div><div class="nav-h">${esc(name)}</div>
      ${keys.map(k => { const v=V[k], n=v.count?v.count():0;
        return `<button class="nav-i ${this.view===k?'on':''}" data-t="${esc(v.t)}"
          aria-label="${esc(v.t)}" onclick="App.go('${k}')">${v.icon}
          <span class="t">${esc(v.t)}</span>
          ${n?`<span class="nav-n ${v.alert?'due':''}">${n}</span>`:''}</button>` }).join('')}
      </div>`).join('');
  },
  rail(){
    const on = !$('#app').classList.contains('rail');
    $('#app').classList.toggle('rail', on);
    localStorage.setItem('aptryk:rail', on ? '1' : '');
    this.railIcon();
  },
  /* The toggle draws the state it will produce: the panel's rail is filled
     when the sidebar is open, hollow when it is collapsed. */
  railIcon(){
    const on = $('#app').classList.contains('rail');
    const f = document.getElementById('railFill');
    if (f) f.setAttribute('opacity', on ? '0' : '.9');
    const b = document.getElementById('railBtn');
    if (b) b.setAttribute('data-tip', on ? 'Expand sidebar' : 'Collapse sidebar');
  },

  foot(n){
    const s = V[this.view], bits = [];
    if (!s.page) bits.push(`${n} ${n===1 ? (s.noun||'item') : (s.nouns || (s.noun ? s.noun+'s' : 'items'))}`);
    if (this.q) bits.push(`matching “${this.q}”`);
    if (this.filter) bits.push(`filtered`);
    if (Sync.queue.length) bits.push(`${Sync.queue.length} to sync`);
    $('#footL').textContent = bits.join('  ·  ');
    $('#footR').innerHTML = `Working as ${esc(memName(S.meId)||'—')}`;
  },

  clear(){ this.q=''; this.filter=null; this.render(); const f=$('#q'); if(f) f.focus() },
  create(){
    const s = V[this.view]; if (!s.make) return;
    const r = s.make(); save(); this.select(r.id);
    requestAnimationFrame(()=>{ const t=$('#sideIn .side-title'); if(t){t.focus(); t.select&&t.select()} });
    toast(`New ${s.noun||'record'} — fill it in on the right`);
  },
  move(d){
    const l = this.rows().filter(o=>!o.group); if (!l.length) return;
    const i = l.findIndex(o=>o.id===this.sel[this.view]);
    const nx = i===-1 ? 0 : Math.min(l.length-1, Math.max(0, i+d));
    this.select(l[nx].id);
    const el = document.querySelector(`.row[data-id="${l[nx].id}"]`);
    if (el) el.scrollIntoView({block:'nearest'});
  },
  patch(rec, ch, note, coll){ if(!rec) return;
    // Snapshot before mutating so the log entry can put it back.
    const before = note ? structuredClone(rec) : null;
    Object.assign(rec, ch); rec.updatedAt = now();
    if (note) log(note, rec.id, coll ? {c:coll, id:rec.id, before} : null);
    save(); this.render() },
  tickRem(id){ const r=S.reminders.find(x=>x.id===id); if(!r) return;
    this.patch(r,{done:!r.done}, `Reminder ${r.done?'reopened':'completed'}: <b>${esc(r.text)}</b>`,
      'reminders') },
  tickCap(id){ const c=S.captures.find(x=>x.id===id); if(!c) return; this.patch(c,{done:!c.done}) },

  async del(kind, id){
    const map = { leads:S.leads, clients:S.clients, work:S.engagements,
      reminders:S.reminders, notes:S.captures, log:S.activity };
    let list = map[kind], rec = list && list.find(o=>o.id===id), from = list;
    if (!rec) for (const k of ['proposals','invoices']){
      const h = S.money[k].find(o=>o.id===id); if (h){ rec=h; from=S.money[k]; break } }
    if (!rec){ rec = S.engagements.find(o=>o.id===id); from = S.engagements }
    if (!rec) return;
    const label = rec.name || rec.text || 'this record';
    const extra = kind==='clients' && projOf(id).length
      ? ` Its ${projOf(id).length} job(s) stay, but lose the link.` : '';
    if (!await Dialog.ask('Delete ' + label + '?',
      'This removes it for everyone on the next sync.' + extra + ' You can undo from the toast.')) return;
    const i = from.indexOf(rec);
    const snapshot = structuredClone(rec);
    from.splice(i,1);
    const collName = { leads:'leads', clients:'clients', work:'engagements',
      reminders:'reminders', notes:'captures', log:'activity' }[kind]
      || (S.money.proposals === from ? 'proposals' : 'invoices');
    if (kind !== 'log')
      log(`Deleted <b>${esc(label)}</b>`, id, {c:collName, id, before:snapshot, at:i});
    if (kind==='clients') S.engagements.forEach(e=>{ if(e.clientId===id){e.clientId=null; e.updatedAt=now()} });
    this.sel[this.view] = null; save(); this.render();
    toast('Deleted ' + label, 'Undo', ()=>{ from.splice(i,0,rec); save(); this.render(); toast('Restored') });
  },
};

/* ─── GRIP / KEYS ────────────────────────────────────────────────── */
const Grip = { bind(){
  const g = $('#grip'); let x=0,w=0,on=false;
  const saved = parseInt(localStorage.getItem('aptryk:sidew')||'',10);
  if (saved>=320 && saved<=680) document.documentElement.style.setProperty('--side-w', saved+'px');
  g.addEventListener('pointerdown', e => { on=true; x=e.clientX;
    w=$('#side').getBoundingClientRect().width; g.setPointerCapture(e.pointerId); e.preventDefault() });
  g.addEventListener('pointermove', e => { if(!on) return;
    const nw = Math.min(680, Math.max(320, w + (x-e.clientX)));
    document.documentElement.style.setProperty('--side-w', nw+'px') });
  const end = () => { if(!on) return; on=false;
    localStorage.setItem('aptryk:sidew', String(Math.round($('#side').getBoundingClientRect().width))) };
  g.addEventListener('pointerup', end); g.addEventListener('pointercancel', end);
}};

/* Accelerators only. Every one has a visible control elsewhere. */
const Keys = { bind(){
  document.addEventListener('keydown', e => {
    const mod = e.metaKey || e.ctrlKey;
    const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName);
    if (mod && e.key.toLowerCase()==='k'){ e.preventDefault(); Palette.open(); return }
    if (Palette.isOpen()){ Palette.key(e); return }
    if (Dialog.isOpen()){
      if (e.key==='Escape'){ e.preventDefault(); Dialog.done(false) }
      if (e.key==='Enter'){ e.preventDefault(); Dialog.done(true) }
      return }
    if (e.key==='Escape'){ Menu.close(); if (typing) document.activeElement.blur(); return }
    if (mod && e.key.toLowerCase()==='n'){ e.preventDefault(); App.create(); return }
    if (typing) return;
    if (e.key==='/'){ e.preventDefault(); const f=$('#q'); if(f) f.focus(); return }
    if (e.key==='ArrowDown'){ e.preventDefault(); App.move(1); return }
    if (e.key==='ArrowUp'){ e.preventDefault(); App.move(-1); return }
  });
  document.addEventListener('input', e => {
    if (e.target.id !== 'q') return;
    App.q = e.target.value;
    clearTimeout(Keys._t);
    Keys._t = setTimeout(() => { const p = e.target.selectionStart; App.render();
      const f = $('#q'); if (f){ f.focus(); f.setSelectionRange(p,p) } }, 120);
  });
}};

/* ─── PALETTE / DIALOG / TOAST ───────────────────────────────────── */
const Palette = {
  items:[], i:0,
  isOpen:()=>$('#paletteWrap').classList.contains('on'),
  open(){ $('#paletteWrap').classList.add('on');
    const el=$('#paletteIn'); el.value=''; el.focus(); this.build('') },
  close(){ $('#paletteWrap').classList.remove('on') },
  build(q){
    const s = q.trim().toLowerCase(), out = [];
    VK.forEach(k => out.push({ kind:'Go', label:V[k].t, sub:'', run:()=>App.go(k) }));
    out.push({ kind:'Do', label:'Sync now', run:()=>Sync.pull(true) });
    out.push({ kind:'Do', label:'Export workspace', run:exportAll });
    Object.entries(THEMES).forEach(([id,t]) =>
      out.push({ kind:'Theme', label:t.name, sub:t.note, run:()=>Theme.set(id) }));
    if (s){
      S.clients.forEach(c=>out.push({kind:'Client',label:c.name||'Untitled',sub:c.industry||'',
        run:()=>App.goTo('clients',c.id)}));
      S.engagements.forEach(e=>out.push({kind:'Work',label:e.name||'Untitled',
        sub:e.kind==='internal'?'Ours':acctName(e), run:()=>App.goTo('work',e.id)}));
      S.leads.forEach(l=>out.push({kind:'Lead',label:l.name||'Unnamed',sub:l.company||'',
        run:()=>App.goTo('leads',l.id)}));
      S.clients.forEach(c=>(c.contacts||[]).forEach(p=>{ if(!p.name) return;
        out.push({kind:'Person',label:p.name,sub:c.name,run:()=>App.goTo('clients',c.id)}) }));
    }
    this.items = (s ? out.filter(o=>(o.label+' '+(o.sub||'')).toLowerCase().includes(s))
                    : out.slice(0, VK.length+2)).slice(0,50);
    this.i = 0; this.paint();
  },
  paint(){
    $('#paletteRes').innerHTML = this.items.length
      ? this.items.map((o,n)=>`<button class="pitem ${n===this.i?'on':''}" onclick="Palette.run(${n})">
          <span class="pkind">${esc(o.kind)}</span><span class="cell">${esc(o.label)}</span>
          <span class="psub">${esc(o.sub||'')}</span></button>`).join('')
      : `<div class="pnil">No match.</div>`;
    const on = document.querySelector('#paletteRes .pitem.on'); if (on) on.scrollIntoView({block:'nearest'});
  },
  run(n){ const o=this.items[n]; if(!o) return; this.close(); o.run() },
  key(e){
    if (e.key==='Escape'){ e.preventDefault(); this.close(); return }
    if (e.key==='ArrowDown'){ e.preventDefault(); this.i=Math.min(this.items.length-1,this.i+1); this.paint(); return }
    if (e.key==='ArrowUp'){ e.preventDefault(); this.i=Math.max(0,this.i-1); this.paint(); return }
    if (e.key==='Enter'){ e.preventDefault(); this.run(this.i); return }
    setTimeout(()=>this.build($('#paletteIn').value),0);
  },
};

const Dialog = {
  _r:null,
  isOpen:()=>$('#dialogWrap').classList.contains('on'),
  ask(t,m,ok='Delete'){
    $('#dialogT').textContent=t; $('#dialogM').textContent=m; $('#dialogOk').textContent=ok;
    $('#dialogWrap').classList.add('on');
    setTimeout(()=>$('#dialogOk').focus(),20);
    return new Promise(r=>{ this._r=r });
  },
  done(v){ $('#dialogWrap').classList.remove('on'); const r=this._r; this._r=null; if(r) r(v) },
};

let _tt;
function toast(msg, label, run){
  const el=$('#toast'), b=$('#toastA');
  $('#toastM').textContent = msg;
  if (label && run){ b.hidden=false; b.textContent=label; b.onclick=()=>{ el.classList.remove('on'); run() } }
  else b.hidden = true;
  el.classList.add('on'); clearTimeout(_tt);
  _tt = setTimeout(()=>el.classList.remove('on'), run?6000:2600);
}

function exportAll(){
  const b = new Blob([JSON.stringify(S,null,2)],{type:'application/json'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(b);
  a.download = `aptryk-${new Date().toISOString().slice(0,10)}.json`;
  a.click(); setTimeout(()=>URL.revokeObjectURL(a.href),800);
  toast('Workspace exported');
}

/* ─── SIDE PANE ──────────────────────────────────────────────────────
   Everything is edited in place. There is no modal for records: on a
   desktop you should always see the list you are working against. */
function anyRec(id){
  return S.clients.find(o=>o.id===id) || S.engagements.find(o=>o.id===id)
    || S.leads.find(o=>o.id===id) || S.reminders.find(o=>o.id===id)
    || S.captures.find(o=>o.id===id) || S.money.proposals.find(o=>o.id===id)
    || S.money.invoices.find(o=>o.id===id) || S.activity.find(o=>o.id===id) || null;
}
const foot = h => `<div class="side-f">${h}</div>`;
