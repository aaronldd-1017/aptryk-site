<style>
/* ══════════════════════════════════════════════════════════════════════
   APTRYK CRM — internal, desktop

   ONE SENTENCE
   A single sheet of dark blue-grey paper with a quiet grid, where the
   only colour is Aptryk blue marking where you are and red marking
   what is late.

   THE FIVE LAWS (each is enforced by harness.py, not by good intentions)

   1. ONE SURFACE. The whole app sits on --paper. No pane, panel, card or
      row gets its own opaque background. Depth comes from translucent
      white washes and hairlines. Only things that genuinely float —
      menus, dialogs, toasts — may lift onto --float with a shadow.

   2. NO FILLED HIGHLIGHTS. Selection and active state are a 3px accent
      bar in the gutter plus a wash under 8% opacity. A saturated block
      behind text is forbidden; the harness fails any selection background
      over 12% alpha.

   3. EVERY VALUE IS A TOKEN. No literal colour, size, radius or space
      appears in a rule below. The harness reads computed styles and fails
      on any orphan. This is the law that actually prevents drift — every
      regression in this project was a hand-typed value.

   4. SMALL VOCABULARY. 7 font sizes, 4 weights, 3 radii, 3 shadows,
      5 ink values, 3 hue families. Sprawl is how an interface becomes
      pieces; the budget is checked per theme.

   5. CONTROLS ARE VISIBLE AT REST. Hover may enrich an affordance. It
      may never be the only way to discover one.
   ══════════════════════════════════════════════════════════════════════ */

/* ─── TOKENS ─────────────────────────────────────────────────────────
   The complete vocabulary. Nothing below this block invents a value. */
:root {
  /* neutrals used for washes — declared so the linter can resolve them */
  --white: #FFFFFF;
  --black: #000000;

  /* type */
  --ff: 'Inter', system-ui, -apple-system, sans-serif;
  --ff-mono: 'JetBrains Mono', ui-monospace, monospace;
  --fs-xs: 11px; --fs-sm: 12px; --fs: 13px; --fs-md: 15px;
  --fs-lg: 18px; --fs-xl: 22px; --fs-2xl: 28px;
  --fw: 400; --fw-md: 500; --fw-sb: 600; --fw-b: 700;

  /* space — every padding, gap and margin comes from here */
  --s1: 2px; --s2: 4px; --s3: 6px; --s4: 8px; --s5: 12px;
  --s6: 16px; --s7: 20px; --s8: 24px; --s9: 32px; --s10: 48px;

  /* radius — controls and floating things only; structure is square */
  --r-sm: 6px; --r: 8px; --r-pill: 999px;

  /* elevation — only for things above the plane */
  --sh-sm: 0 1px 3px rgba(0,0,0,.30);
  --sh: 0 8px 24px rgba(0,0,0,.42);
  --sh-lg: 0 24px 56px rgba(0,0,0,.55);

  /* geometry */
  --nav-w: 208px; --nav-rail: 52px; --side-w: 400px;
  --bar-h: 52px; --foot-h: 28px; --row-h: 40px; --ctl-h: 32px;
  --pad: 24px;

  --t: 130ms;                                  /* state change */
  --t-slow: 240ms;                             /* entrances */
  --ease: cubic-bezier(.2,.7,.3,1);            /* everything */
  --ease-out: cubic-bezier(.16,1,.3,1);        /* things arriving */
}
[data-density="compact"] { --row-h: 32px; --pad: 16px; --ctl-h: 28px }

/* ─── THEME: APTRYK ──────────────────────────────────────────────────
   Blue-black, lifted well off the near-black of aptryk.com because this
   is read all day rather than scrolled once. Accent is the site's exact
   #4A7CF5. */
[data-theme="aptryk"] {
  --paper:  #171A21;
  --float:  #21252E;
  --sunk:   rgba(0,0,0,.22);
  --wash:   rgba(255,255,255,.035);
  --wash-2: rgba(255,255,255,.070);
  --line:   rgba(255,255,255,.075);
  --line-2: rgba(255,255,255,.140);

  --ink:   #ECEFF7;
  --ink-2: #A8AFC2;
  --ink-3: #8B93A8;

  --edge:        #5F87F0;   /* 1px focus border — accent, quieted */
  --halo:        rgba(74,124,245,.20);  /* soft focus ring only */
  --select:      rgba(255,255,255,.17);  /* text selection — never accent */
  --accent:      #4A7CF5;   /* brand value: bars, marks, dots */
  --accent-fill: #3F6BE0;   /* 4.8:1 with white — filled controls */
  --accent-hi:   #4C77E8;   /* the same fill, one step up, for hover */
  --accent-txt:  #92B0FA;   /* 4.5:1+ on paper — coloured text */
  --on-accent:   #FFFFFF;

  --alert:     #F0736B;
  --alert-txt: #F0736B;
  --ok:        #55C98C;
}

/* ─── THEME: LIGHT ───────────────────────────────────────────────────
   Same components, inverted. Exists to prove no component assumes a dark
   background — the real test of whether the token layer is a layer. */
[data-theme="light"] {
  --paper:  #FBFBFD;
  --float:  #FFFFFF;
  --sunk:   rgba(0,0,0,.040);
  --wash:   rgba(0,0,0,.030);
  --wash-2: rgba(0,0,0,.060);
  --line:   rgba(0,0,0,.090);
  --line-2: rgba(0,0,0,.150);

  --ink:   #12151C;
  --ink-2: #454B5C;
  --ink-3: #5B6273;

  --edge:        #4C71DE;
  --halo:        rgba(53,96,220,.16);
  --select:      rgba(20,24,40,.13);
  --accent:      #3560DC;
  --accent-fill: #3560DC;
  --accent-hi:   #2C50B8;
  --accent-txt:  #2C50B8;
  --on-accent:   #FFFFFF;

  --alert:     #C03028;
  --alert-txt: #B32B24;
  --ok:        #177A45;
}

/* ─── BASE ───────────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0 }
/* Author display rules outrank the UA [hidden] rule, so state this once,
   loudly, rather than remembering it at every call site. */
[hidden] { display: none !important }
html, body {
  height: 100%; background: var(--paper); color: var(--ink);
  font-family: var(--ff); font-size: var(--fs); line-height: 1.5;
  -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
  overflow: hidden;
}
button, input, select, textarea { font: inherit; color: inherit; background: none; border: none; outline: none }
button { cursor: pointer; text-align: left }
/* Chrome is not text. Clicking a row, a nav item or a header should select
   the record, never the label underneath it. */
.nav, .bar, .cols, .sum, .foot, .tabs, .metrics, .row, .group, .head,
.btn, .act, .rail-btn, .track, .who, .kind, .tag, .sec-h, .block-h,
.empty, .void { user-select: none }
/* Everything you might genuinely want to copy stays selectable. */
.side-b, .page, .field, .area, .sel, .log, .mini-m,
input, textarea { user-select: text }
a { color: inherit; text-decoration: none }
svg { display: block }
::selection { background: var(--select); color: var(--ink) }
::-webkit-scrollbar { width: 10px; height: 10px }
::-webkit-scrollbar-track { background: none }
::-webkit-scrollbar-thumb { background: var(--line); border-radius: var(--r-pill);
  border: 3px solid transparent; background-clip: content-box;
  transition: background var(--t) }
::-webkit-scrollbar-thumb:hover { background: var(--ink-4); background-clip: content-box }
.rows:hover::-webkit-scrollbar-thumb, .side-b:hover::-webkit-scrollbar-thumb,
.page:hover::-webkit-scrollbar-thumb { background: var(--line-2); background-clip: content-box }
:focus-visible { outline: 2px solid var(--edge); outline-offset: 2px; border-radius: var(--r-sm) }
/* Fields draw their own focus ring as an inset shadow. Without this they
   get both, which reads as a doubled outline with a gap between. */
.field:focus-visible, .sel:focus-visible, .area:focus-visible,
.side-title:focus-visible, .field:focus, .sel:focus, .area:focus,
.side-title:focus { outline: none }

/* ─── DESKTOP GATE ───────────────────────────────────────────────── */
.gate { display: none }
@media (max-width: 1099px), (pointer: coarse) {
  .app, .float-layer { display: none !important }
  .gate { display: flex; flex-direction: column; justify-content: center;
    height: 100%; padding: 0 var(--s9); max-width: 520px; margin: 0 auto }
  .gate h1 { font-size: var(--fs-2xl); font-weight: var(--fw-b);
    letter-spacing: -.02em; margin-bottom: var(--s5) }
  .gate p { color: var(--ink-2); font-size: var(--fs-md); line-height: 1.6; margin-bottom: var(--s4) }
}

/* ─── SHELL ──────────────────────────────────────────────────────────
   Three regions on ONE sheet. Separation is a hairline and space. */
.app {
  height: 100%; display: grid;
  grid-template-columns: var(--nav-w) minmax(0,1fr) var(--side-w);
  grid-template-rows: var(--bar-h) minmax(0,1fr) var(--foot-h);
  grid-template-areas: "bar bar bar" "nav main side" "foot foot foot";
}
.app.rail { --nav-w: var(--nav-rail) }
.app.solo { grid-template-columns: var(--nav-w) minmax(0,1fr) 0 }
.app.solo .side { display: none }

/* ─── TOP BAR ────────────────────────────────────────────────────── */
.bar { grid-area: bar; display: flex; align-items: center; gap: var(--s5);
  padding: 0 var(--pad); border-bottom: 1px solid var(--line) }
.rail-btn { width: 30px; height: 30px; border-radius: var(--r-sm);
  display: inline-flex; align-items: center; justify-content: center;
  color: var(--ink-3); flex-shrink: 0; transition: background var(--t), color var(--t) }
.rail-btn:hover { background: var(--wash-2); color: var(--ink) }
.rail-btn svg { width: 16px; height: 16px;
  transition: transform var(--t) var(--ease) }
.rail-btn:hover svg { transform: scale(1.06) }
.rail-btn:active svg { transform: scale(.94) }
.brand { display: flex; align-items: center; gap: var(--s4); flex-shrink: 0 }
.brand svg { width: 22px; height: 22px; color: var(--accent) }
.brand b { font-size: var(--fs-md); font-weight: var(--fw-b); letter-spacing: .04em }
.bar-gap { flex: 1 }
.bar-end { display: flex; align-items: center; gap: var(--s4); flex-shrink: 0 }

/* ─── MASTER SEARCH ─────────────────────────────────────────────────── */
.search-btn { position: relative; overflow: hidden; padding-right: var(--s5) }
.search-btn svg { transition: transform var(--t) var(--ease), color var(--t) }
.search-btn kbd { transition: transform var(--t) var(--ease), opacity var(--t),
  background var(--t), color var(--t) }
.search-btn:hover { background: var(--wash-2); color: var(--ink);
  box-shadow: inset 0 0 0 1px var(--line-2) }
.search-btn:hover svg { transform: scale(1.14) rotate(-8deg); color: var(--accent-txt) }
.search-btn:hover kbd { transform: translateX(-1px); background: var(--wash-2); color: var(--ink-2) }
.search-btn:active { transform: translateY(.5px) }
/* a light sweeps across the glass on hover — one pass, no loop */
.search-btn::after { content: ''; position: absolute; inset: 0;
  background: linear-gradient(105deg, transparent 38%, var(--wash-2) 50%, transparent 62%);
  transform: translateX(-120%); pointer-events: none }
.search-btn:hover::after { transform: translateX(120%); transition: transform 620ms var(--ease) }

/* ─── CONTROLS ───────────────────────────────────────────────────── */
.btn {
  height: var(--ctl-h); padding: 0 var(--s5); display: inline-flex;
  align-items: center; justify-content: center; gap: var(--s3);
  border-radius: var(--r); font-size: var(--fs); font-weight: var(--fw-md);
  color: var(--ink-2); box-shadow: inset 0 0 0 1px var(--line-2);
  white-space: nowrap; transition: background var(--t), color var(--t);
}
.btn:hover { background: var(--wash); color: var(--ink);
  box-shadow: inset 0 0 0 1px var(--line-2) }
.btn:active { transform: translateY(.5px) }
/* Icons scale with their label. See note above: px icons beside token
   text is what made the small buttons look off. */
.btn svg { width: 1.05em; height: 1.05em; flex-shrink: 0 }
.btn-primary { background: var(--accent-fill); color: var(--on-accent);
  box-shadow: none; font-weight: var(--fw-sb) }
.btn-primary:hover { background: var(--accent-hi); color: var(--on-accent) }
.btn-quiet { box-shadow: none; color: var(--ink-3) }
.btn-quiet:hover { background: var(--wash-2); color: var(--ink);
  box-shadow: inset 0 0 0 1px var(--line-2) }
.btn-quiet:hover svg { color: var(--ink-2) }
.btn-quiet kbd { transition: background var(--t), color var(--t) }
.btn-quiet:hover kbd { background: var(--wash-2); color: var(--ink-2) }
.btn-sm { height: 28px; padding: 0 var(--s4); font-size: var(--fs-sm) }
.btn-ico { width: var(--ctl-h); padding: 0 }
.btn-ico.btn-sm { width: 28px }
.btn-alert { color: var(--alert-txt) }
.btn-alert:hover { background: var(--wash-2); color: var(--alert-txt) }

/* The sync chip is a word, not a light. The dot idiom is gone from the
   whole interface — it named a category and told you nothing else. */
.sync-w { font-size: var(--fs-sm); color: var(--ink-2) }
.sync-w.bad { color: var(--alert-txt) }
.sync-w.ok { color: var(--ink-2) }

/* Kind mark: House work is ours, Client work is theirs. A one-glyph
   distinction that never needs a colour. */
.kind { font-size: var(--fs-xs); font-weight: var(--fw-sb); letter-spacing: .1em;
  text-transform: uppercase; color: var(--ink-3) }
.kind.house { color: var(--accent-txt) }

.field, .sel {
  width: 100%; height: var(--ctl-h); padding: 0 var(--s4);
  border-radius: var(--r-sm); background: var(--sunk); color: var(--ink);
  font-size: var(--fs); box-shadow: inset 0 0 0 1px var(--line);
  transition: box-shadow var(--t), background var(--t);
}
.field::placeholder { color: var(--ink-3) }
.field:hover, .sel:hover { background: var(--wash);
  box-shadow: inset 0 0 0 1px var(--line-2) }
.field:focus, .sel:focus { background: var(--wash);
  box-shadow: inset 0 0 0 1px var(--edge), 0 0 0 3px var(--halo) }
.sel { cursor: pointer; appearance: none; padding-right: var(--s8) }
.sel option { background: var(--float); color: var(--ink) }
.area { width: 100%; padding: var(--s4); border-radius: var(--r-sm);
  background: var(--sunk); color: var(--ink); font-family: var(--ff);
  font-size: var(--fs); line-height: 1.6; min-height: 76px; resize: vertical;
  box-shadow: inset 0 0 0 1px var(--line); transition: box-shadow var(--t), background var(--t) }
.area:hover { background: var(--wash); box-shadow: inset 0 0 0 1px var(--line-2) }
.area:focus { background: var(--wash);
  box-shadow: inset 0 0 0 1px var(--edge), 0 0 0 3px var(--halo) }

.tabs { display: inline-flex; align-items: center; gap: var(--s1);
  background: var(--sunk); padding: 3px; border-radius: var(--r) }
.tabs button { height: 26px; padding: 0 var(--s5); border-radius: var(--r-sm);
  font-size: var(--fs-sm); font-weight: var(--fw-md); color: var(--ink-3);
  transition: background var(--t), color var(--t) }
.tabs button:hover { color: var(--ink) }
.tabs button.on { background: var(--wash-2); color: var(--ink); font-weight: var(--fw-sb) }

kbd { font-family: var(--ff-mono); font-size: var(--fs-xs); color: var(--ink-3);
  background: var(--wash); padding: var(--s1) var(--s3); border-radius: var(--r-sm) }

/* ─── NAV ────────────────────────────────────────────────────────── */
.nav { grid-area: nav; display: flex; flex-direction: column; overflow-y: auto;
  padding: var(--s4) var(--s5) 0; border-right: 1px solid var(--line) }
.nav-h { font-size: var(--fs-xs); font-weight: var(--fw-sb); letter-spacing: .1em;
  text-transform: uppercase; color: var(--ink-3); padding: var(--s6) var(--s4) var(--s3) }
.nav-i { position: relative; width: 100%; display: flex; align-items: center;
  gap: var(--s4); height: 32px; padding: 0 var(--s4); border-radius: var(--r);
  color: var(--ink-2); font-size: var(--fs); font-weight: var(--fw-md);
  transition: background var(--t), color var(--t) }
.nav-i::before { content: ''; position: absolute; left: calc(var(--s5) * -1);
  top: 50%; transform: translateY(-50%); height: 0; width: 3px;
  border-radius: 0 var(--r-pill) var(--r-pill) 0; background: none;
  transition: height var(--t) var(--ease), background var(--t) }
.nav-i:hover::before { height: 36%; background: var(--line-2) }
.nav-i.on::before { height: 56% }
.nav-i svg { transition: transform var(--t) var(--ease), color var(--t) }
.nav-i:hover svg { transform: translateX(1px) }
.nav-i svg { width: 1.05em; height: 1.05em; flex-shrink: 0 }
.nav-i span.t { flex: 1; min-width: 0; overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap }
.nav-i:hover { background: var(--wash); color: var(--ink) }
/* Law 2: active state is an accent bar and accent ink. No filled block. */
.nav-i.on { color: var(--accent-txt); font-weight: var(--fw-sb) }
.nav-i.on::before { background: var(--accent) }
.nav-i.on svg { color: var(--accent-txt) }
.nav-n { font-family: var(--ff-mono); font-size: var(--fs-xs);
  color: var(--ink-3); font-variant-numeric: tabular-nums }
.nav-i.on .nav-n { color: var(--accent-txt) }
.nav-n.due { color: var(--alert-txt); font-weight: var(--fw-sb) }
.nav-foot { margin-top: auto; padding-bottom: var(--s4) }
.app.rail .nav-h { height: 1px; overflow: hidden; color: transparent;
  padding: 0; margin: var(--s5) auto var(--s4); width: 16px; background: var(--line) }
.app.rail .nav { padding-left: var(--s3); padding-right: var(--s3) }
.app.rail .nav-i { justify-content: center; padding: 0; height: 36px }
.app.rail .nav-i::before { left: calc(var(--s3) * -1) }
.app.rail .nav-i span.t, .app.rail .nav-i .nav-n, .app.rail .rail-t { display: none }
.app.rail .nav-i::after { content: attr(data-t); position: absolute;
  left: calc(100% + var(--s4)); top: 50%; transform: translateY(-50%);
  background: var(--float); color: var(--ink); font-size: var(--fs-sm);
  padding: var(--s3) var(--s4); border-radius: var(--r-sm); white-space: nowrap;
  box-shadow: var(--sh-sm); opacity: 0; pointer-events: none; z-index: 5 }
.app.rail .nav-i:hover::after { opacity: 1 }

/* ─── MAIN ───────────────────────────────────────────────────────── */
.main { grid-area: main; display: flex; flex-direction: column;
  min-width: 0; overflow: hidden }
.head { flex-shrink: 0; padding: var(--s7) var(--pad) 0 }
.title { font-size: var(--fs-xl); font-weight: var(--fw-b);
  letter-spacing: -.028em; line-height: 1.15; font-feature-settings: 'ss01','cv05' }
.blurb { font-size: var(--fs); color: var(--ink-3); margin-top: var(--s2);
  max-width: 68ch; line-height: 1.5 }

/* Metrics read as a line of facts, not a row of tiles. Each is a button
   that filters the list — a number you cannot act on is decoration. */
.metrics { display: flex; flex-wrap: wrap; gap: var(--s8); margin-top: var(--s6) }
.metric { text-align: left; border-radius: var(--r-sm); padding: var(--s3) var(--s3); min-height: 44px;
  margin-left: calc(var(--s3) * -1); transition: background var(--t) }
.metric:hover { background: var(--wash) }
.metric.on { background: var(--wash-2) }
.metric-k { font-size: var(--fs-xs); font-weight: var(--fw-sb); letter-spacing: .08em;
  text-transform: uppercase; color: var(--ink-3) }
.metric { transition: background var(--t) var(--ease) }
.metric-v { transition: transform var(--t) var(--ease), color var(--t) }
.metric:hover .metric-v { transform: translateY(-1px) }
.metric.on .metric-v { color: var(--accent-txt) }
.metric-v { font-family: var(--ff-mono); font-size: var(--fs-lg);
  font-weight: var(--fw-md); color: var(--ink); font-variant-numeric: tabular-nums;
  line-height: 1.25; letter-spacing: -.02em; margin-top: var(--s1) }
.metric-v.due { color: var(--alert-txt) }
.metric-v.act { color: var(--accent-txt) }

.tools { display: flex; align-items: center; gap: var(--s4);
  padding: var(--s6) var(--pad) var(--s5); flex-shrink: 0 }
.find { position: relative; flex: 1; max-width: 320px }
.find svg { position: absolute; left: var(--s4); top: 50%; transform: translateY(-50%);
  width: 14px; height: 14px; color: var(--ink-3); pointer-events: none }
.find .field { padding-left: var(--s9) }
.find svg { transition: color var(--t) }
.find:hover svg, .find:focus-within svg { color: var(--ink-2) }
.find:focus-within .field { background: var(--wash) }
.tools-gap { flex: 1 }

/* ─── TABLE ──────────────────────────────────────────────────────── */
.cols { display: grid; gap: var(--s6); align-items: center; flex-shrink: 0;
  padding: 0 var(--pad); height: 32px; border-bottom: 1px solid var(--line);
  font-size: var(--fs-xs); font-weight: var(--fw-sb); letter-spacing: .08em;
  text-transform: uppercase; color: var(--ink-3) }
.cols button { display: inline-flex; align-items: center; gap: var(--s2); height: 30px;
  color: var(--ink-3); font: inherit; letter-spacing: inherit; text-transform: inherit }
.cols button:hover { color: var(--ink) }
.cols button.on { color: var(--ink) }
.cols svg { width: 1.05em; height: 1.05em }
.num { text-align: right; justify-content: flex-end }

.rows { flex: 1; overflow-y: auto; overflow-x: hidden; min-height: 0;
  display: flex; flex-direction: column; padding-bottom: var(--s5) }
.rows > *, .page > * { animation: settle var(--t-slow) var(--ease-out) both }
@keyframes settle { from { opacity: 0; transform: translateY(3px) } }

.row { position: relative; width: 100%; display: grid; gap: var(--s6);
  align-items: center; padding: 0 var(--pad); height: var(--row-h);
  color: var(--ink-2); font-size: var(--fs); cursor: pointer;
  transition: background var(--t) }
.row::before { content: ''; position: absolute; left: 0; top: 50%; height: 0;
  transform: translateY(-50%); width: 3px;
  border-radius: 0 var(--r-pill) var(--r-pill) 0; background: none;
  transition: height var(--t) var(--ease), background var(--t) }
/* Hovering shows a short stub of the bar you are about to commit to. */
.row:hover::before { height: 40%; background: var(--line-2) }
.row.on::before, .row.due::before { height: calc(100% - var(--s6)) }
.row + .row::after { content: ''; position: absolute; left: var(--pad); right: var(--pad);
  top: 0; height: 1px; background: var(--line); opacity: 0; transition: opacity var(--t) }
.rows:hover .row + .row::after { opacity: 1 }
.row:hover { background: var(--wash) }
/* Rows show focus with the gutter mark and wash, like selection — an
   outline on top of that is a third indicator for the same fact, and it
   lingers after a right-click. */
.row:focus-visible { outline: none; background: var(--wash-2) }
.row:focus-visible::before { height: calc(100% - var(--s6)); width: 5px;
  background: var(--edge) }
.row.on:focus-visible::before { background: var(--accent) }
.row:hover::after, .row:hover + .row::after { opacity: 0 !important }
.row.on { background: var(--wash-2) }
.row.on::before { background: var(--accent) }
.row.due::before { background: var(--alert) }
.row.on.due::before { background: var(--accent) }
.cell { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap }
.strong { color: var(--ink); font-weight: var(--fw-md) }
.mono { font-family: var(--ff-mono); font-size: var(--fs-sm);
  font-variant-numeric: tabular-nums; color: var(--ink-2) }
.mono.strong { color: var(--ink) }
.quiet { color: var(--ink-3) }
.late { color: var(--alert-txt) }
.good { color: var(--ok) }

/* ─── THE TRACK ──────────────────────────────────────────────────────
   One designed idiom for every kind of state in the app, replacing the
   coloured dots. A dot tells you a category; a track tells you WHERE
   something is in its life and how far it has left to go — the same
   information, plus the thing you actually wanted to know.

   Segments read left to right: passed steps are solid ink, the current
   step is accent and wider, steps ahead are hollow. Used for the work
   lifecycle (4 steps), signal warmth (3) and money (3), so learning it
   once teaches the whole interface.

   It also earns its place on the ink budget: the label is plain --ink-2
   in every state, so meaning never rests on colour alone. */
.track { display: inline-flex; align-items: center; gap: var(--s3); white-space: nowrap }
.track-g { display: inline-flex; align-items: center; gap: 2px; flex-shrink: 0 }
.track-g i { width: 7px; height: 3px; border-radius: var(--r-pill);
  background: var(--wash-2);
  transition: background var(--t) var(--ease), width var(--t) var(--ease) }
.track-g i.was { background: var(--ink-3) }
.track-g i.is  { width: 15px; background: var(--accent) }
.track.warn .track-g i.is { background: var(--alert) }
.track.done .track-g i { background: var(--ink-3) }
.track.done .track-g i.is { width: 15px }
.track-t { font-size: var(--fs-sm); color: var(--ink-2) }
.track.done .track-t { color: var(--ink-3) }


.tag { display: inline-flex; align-items: center; height: 20px; padding: 0 var(--s4);
  border-radius: var(--r-pill); background: var(--wash-2);
  font-size: var(--fs-xs); color: var(--ink-2) }
.who { display: inline-flex; align-items: center; justify-content: center;
  width: 24px; height: 24px; flex-shrink: 0; border-radius: var(--r-pill);
  background: var(--wash-2); font-size: var(--fs-xs); font-weight: var(--fw-sb);
  color: var(--ink-2) }
.who.nil { color: var(--ink-3); box-shadow: inset 0 0 0 1px var(--line-2); background: none }
.meter { height: 3px; border-radius: var(--r-pill); background: var(--wash-2);
  overflow: hidden; min-width: 40px }
.meter i { display: block; height: 100%; background: var(--accent) }

/* Row controls exist at rest in the DOM and are revealed on hover, never
   created on hover — the slot is always reserved so nothing shifts. */
.acts { display: flex; align-items: center; gap: var(--s1); justify-content: flex-end;
  opacity: 0; transition: opacity var(--t) }
.row:hover .acts, .row.on .acts, .acts:focus-within { opacity: 1 }
.act { width: 26px; height: 26px; border-radius: var(--r-sm);
  display: inline-flex; align-items: center; justify-content: center;
  color: var(--ink-3); transition: background var(--t), color var(--t) }
.act svg { width: 14px; height: 14px }
.act:hover { background: var(--wash-2); color: var(--ink) }

.group { display: grid; grid-template-columns: 1fr auto; gap: var(--s5);
  align-items: center; padding: var(--s7) var(--pad) var(--s3) }
.group-t { display: flex; align-items: baseline; gap: var(--s4);
  font-size: var(--fs-xs); font-weight: var(--fw-sb); letter-spacing: .08em;
  text-transform: uppercase; color: var(--ink-2); min-width: 0 }
/* The lifecycle explains itself in place, so nobody has to be told what
   Shape or Run means. */
.group-n { font-size: var(--fs-sm); font-weight: var(--fw); letter-spacing: 0;
  text-transform: none; color: var(--ink-3); min-width: 0; overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap }

.sum { flex-shrink: 0; display: grid; gap: var(--s6); align-items: center;
  padding: 0 var(--pad); height: 36px; border-top: 1px solid var(--line);
  font-size: var(--fs-sm); color: var(--ink-3); font-variant-numeric: tabular-nums }
.sum:empty { display: none }

.void { flex: 1; display: flex; flex-direction: column; align-items: center;
  justify-content: center; text-align: center; padding: var(--s10) var(--pad) }
.void > svg { width: 22px; height: 22px; color: var(--ink-3); margin-bottom: var(--s5) }
.void h3 { font-size: var(--fs-lg); font-weight: var(--fw-sb); margin-bottom: var(--s3) }
.void p { color: var(--ink-3); max-width: 44ch; line-height: 1.6; margin-bottom: var(--s6) }

/* ─── SIDE PANE ──────────────────────────────────────────────────── */
.side { grid-area: side; display: flex; flex-direction: column; min-width: 0;
  border-left: 1px solid var(--line); position: relative }
.grip { position: absolute; left: -3px; top: 0; bottom: 0; width: 6px; cursor: col-resize }
.grip:hover { background: var(--wash-2) }
.side-h { padding: var(--s7) var(--pad) var(--s5); flex-shrink: 0 }
.side-top { display: flex; align-items: center; gap: var(--s4); margin-bottom: var(--s4) }
.eyebrow { font-size: var(--fs-xs); font-weight: var(--fw-sb); letter-spacing: .1em;
  text-transform: uppercase; color: var(--ink-3) }
.side-x { margin-left: auto; display: flex; gap: var(--s1) }
.side-title { font-size: var(--fs-xl); font-weight: var(--fw-b); letter-spacing: -.02em;
  line-height: 1.25; color: var(--ink); width: 100%; padding: var(--s2) var(--s3);
  margin-left: calc(var(--s3) * -1); border-radius: var(--r-sm);
  transition: background var(--t) }
.side-title:hover { background: var(--wash) }
.side-title:focus { background: var(--wash);
  box-shadow: inset 0 0 0 1px var(--edge), 0 0 0 3px var(--halo) }
.side-sub { margin-top: var(--s4); display: flex; align-items: center; gap: var(--s4);
  flex-wrap: wrap; font-size: var(--fs-sm); color: var(--ink-3) }
.side-b { flex: 1; overflow-y: auto; min-height: 0; padding: 0 var(--pad) var(--s8) }
.sec { padding: var(--s6) 0 var(--s2) }
.sec + .sec { border-top: 1px solid var(--line) }
.sec-h { display: flex; align-items: center; justify-content: space-between;
  gap: var(--s4); margin-bottom: var(--s5); font-size: var(--fs-xs);
  font-weight: var(--fw-sb); letter-spacing: .1em; text-transform: uppercase;
  color: var(--ink-3) }
.kv { display: grid; grid-template-columns: 88px minmax(0,1fr); align-items: center;
  gap: var(--s5); padding: var(--s2) 0 }
.kv-k { font-size: var(--fs-sm); color: var(--ink-3) }
.hint { font-size: var(--fs-xs); color: var(--ink-3); line-height: 1.5;
  padding: var(--s2) 0 var(--s3) }
.mini { display: flex; flex-direction: column; gap: var(--s1) }
.mini-r { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: var(--s5);
  align-items: center; padding: var(--s3) var(--s4); border-radius: var(--r-sm);
  background: var(--wash); font-size: var(--fs) }
.mini-r:hover { background: var(--wash-2) }
.mini-m { min-width: 0; display: flex; align-items: center; gap: var(--s4);
  color: var(--ink-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap }
.mini-m a { display: inline-flex; align-items: center; min-height: 24px;
  color: var(--accent-txt) }
.mini-m a:hover { text-decoration: underline }
.mini-x { width: 24px; height: 24px; display: inline-flex; align-items: center;
  justify-content: center; border-radius: var(--r-sm); color: var(--ink-3); flex-shrink: 0 }
.mini-x svg { width: 13px; height: 13px }
.mini-x:hover { background: var(--wash-2); color: var(--alert-txt) }
.mini-nil { padding: var(--s5); border-radius: var(--r-sm); background: var(--wash);
  color: var(--ink-3); font-size: var(--fs-sm); text-align: center }
.tick svg { transition: opacity var(--t) var(--ease), transform var(--t) var(--ease) }
.tick.on svg { transform: scale(1) }
.tick svg { transform: scale(.6) }
.tick { width: 16px; height: 16px; flex-shrink: 0; border-radius: var(--r-sm);
  box-shadow: inset 0 0 0 2px var(--line-2); display: inline-flex;
  align-items: center; justify-content: center; cursor: pointer;
  transition: background var(--t), box-shadow var(--t) }
.tick svg { width: 10px; height: 10px; color: var(--on-accent); opacity: 0 }
.tick:hover { box-shadow: inset 0 0 0 2px var(--accent) }
.tick.on { background: var(--accent-fill); box-shadow: inset 0 0 0 2px var(--accent-fill) }
.tick.on svg { opacity: 1 }
.done .mini-m { color: var(--ink-3); text-decoration: line-through }
.log { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: var(--s5);
  padding: var(--s3) 0; font-size: var(--fs-sm); color: var(--ink-3); line-height: 1.5 }
.log b { color: var(--ink-2); font-weight: var(--fw-md) }
.side-f { flex-shrink: 0; display: flex; gap: var(--s4); align-items: center;
  padding: var(--s5) var(--pad); border-top: 1px solid var(--line) }
.side-f .btn-alert { margin-left: auto }

/* ─── PAGE (settings) ────────────────────────────────────────────── */
.page { flex: 1; overflow-y: auto; min-height: 0; padding: 0 var(--pad) var(--s10) }
.page-w { max-width: 760px }
.block { padding: var(--s7) 0 }
.block + .block { border-top: 1px solid var(--line) }
.block-h { display: flex; align-items: center; justify-content: space-between;
  gap: var(--s5); margin-bottom: var(--s3) }
.block-t { font-size: var(--fs-md); font-weight: var(--fw-sb) }
.block-d { font-size: var(--fs-sm); color: var(--ink-3); line-height: 1.6;
  margin-bottom: var(--s6); max-width: 64ch }
.swatches { display: flex; gap: var(--s5); flex-wrap: wrap }
.swatch { border-radius: var(--r); overflow: hidden; width: 168px;
  box-shadow: inset 0 0 0 1px var(--line); transition: box-shadow var(--t) }
.swatch:hover { box-shadow: inset 0 0 0 1px var(--line-2) }
.swatch.on { box-shadow: inset 0 0 0 2px var(--accent) }
.swatch-p { height: 52px; display: flex }
.swatch-p i { flex: 1 }
.swatch-b { padding: var(--s4) var(--s5); font-size: var(--fs-sm); min-height: 40px;
  font-weight: var(--fw-md); display: flex; align-items: center; gap: var(--s3) }
.swatch-b svg { width: 1.05em; height: 1.05em; color: var(--accent-txt) }

/* ─── FOOT ───────────────────────────────────────────────────────── */
.foot { grid-area: foot; display: flex; align-items: center; gap: var(--s6);
  padding: 0 var(--pad); border-top: 1px solid var(--line);
  font-size: var(--fs-sm); color: var(--ink-3) }
.foot-gap { flex: 1 }

/* ─── FLOATING ───────────────────────────────────────────────────── */
.menu { position: fixed; z-index: 40; min-width: 190px; background: var(--float);
  border-radius: var(--r); box-shadow: var(--sh); padding: var(--s2); display: none }
.menu.on { display: block; animation: rise var(--t) var(--ease-out) both }
@keyframes rise { from { opacity: 0; transform: translateY(-4px) scale(.985) } }
.menu button { width: 100%; display: flex; align-items: center; gap: var(--s4);
  height: 30px; padding: 0 var(--s4); border-radius: var(--r-sm);
  font-size: var(--fs); color: var(--ink-2) }
.menu button svg { width: 14px; height: 14px }
.menu button:hover { background: var(--wash-2); color: var(--ink) }
.menu button.bad { color: var(--alert-txt) }
.menu hr { border: none; height: 1px; background: var(--line); margin: var(--s2) 0 }
.menu-h { font-size: var(--fs-xs); font-weight: var(--fw-sb); letter-spacing: .08em;
  text-transform: uppercase; color: var(--ink-3); padding: var(--s4) var(--s4) var(--s2) }

.scrim { position: fixed; inset: 0; z-index: 50; display: none;
  background: rgba(0,0,0,.55); align-items: flex-start; justify-content: center;
  padding-top: 12vh }
.scrim.on { display: flex; animation: veil var(--t) var(--ease) both }
@keyframes veil { from { opacity: 0 } }
.scrim.mid { align-items: center; padding-top: 0 }
.palette { width: 560px; max-width: 92vw; background: var(--float);
  border-radius: var(--r); box-shadow: var(--sh-lg); display: flex;
  flex-direction: column; max-height: 60vh; overflow: hidden;
  animation: drop var(--t-slow) var(--ease-out) both }
@keyframes drop { from { opacity: 0; transform: translateY(-12px) scale(.97) } }
.palette-i svg { transition: color var(--t) }
.palette-i:focus-within svg { color: var(--accent-txt) }
.palette-i { display: flex; align-items: center; gap: var(--s5);
  padding: var(--s5) var(--s6); border-bottom: 1px solid var(--line) }
.palette-i svg { width: 15px; height: 15px; color: var(--ink-3) }
.palette-i input { flex: 1; font-size: var(--fs-md) }
.palette-i input::placeholder { color: var(--ink-3) }
.palette-r { overflow-y: auto; min-height: 0; padding: var(--s2) }
.pitem { width: 100%; display: grid; grid-template-columns: 62px minmax(0,1fr) auto;
  gap: var(--s5); align-items: center; height: 36px; padding: 0 var(--s5);
  border-radius: var(--r-sm); color: var(--ink-2); font-size: var(--fs) }
.pitem { transition: background var(--t) }
.pitem.on { background: var(--wash-2); color: var(--ink) }
.pitem.on .pkind { color: var(--accent-txt) }
.pkind { font-size: var(--fs-xs); font-weight: var(--fw-sb); letter-spacing: .06em;
  text-transform: uppercase; color: var(--ink-3) }
.psub { font-size: var(--fs-sm); color: var(--ink-3) }
.pnil { padding: var(--s7); text-align: center; color: var(--ink-3) }

.dialog { width: 400px; max-width: 92vw; background: var(--float);
  border-radius: var(--r); box-shadow: var(--sh-lg); padding: var(--s7);
  animation: drop var(--t-slow) var(--ease-out) both }
.dialog h3 { font-size: var(--fs-lg); font-weight: var(--fw-sb); margin-bottom: var(--s3) }
.dialog p { color: var(--ink-2); line-height: 1.6; margin-bottom: var(--s7) }
.dialog-a { display: flex; gap: var(--s4); justify-content: flex-end }

.toast { position: fixed; bottom: var(--s10); left: 50%;
  transform: translateX(-50%) translateY(10px); z-index: 60; display: flex;
  align-items: center; gap: var(--s5); background: var(--float);
  border-radius: var(--r); box-shadow: var(--sh); padding: var(--s5) var(--s6);
  font-size: var(--fs); color: var(--ink); opacity: 0; pointer-events: none;
  transition: opacity var(--t) var(--ease), transform var(--t) var(--ease) }
.toast.on { opacity: 1; transform: translateX(-50%); pointer-events: auto }
.toast button { color: var(--accent-txt); font-weight: var(--fw-sb) }

.tip { position: relative }
.tip::after { content: attr(data-tip); position: absolute; bottom: calc(100% + var(--s3));
  left: 50%; transform: translateX(-50%); background: var(--float); color: var(--ink);
  font-size: var(--fs-xs); padding: var(--s2) var(--s4); border-radius: var(--r-sm);
  white-space: nowrap; box-shadow: var(--sh-sm); opacity: 0; pointer-events: none;
  z-index: 30 }
.tip:hover::after { opacity: 1 }
/* Anything in the top bar has no room above it — flip the tip below. */
.bar .tip::after { bottom: auto; top: calc(100% + var(--s3)) }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { transition-duration: .01ms !important;
    animation-duration: .01ms !important; animation-iteration-count: 1 !important }
}
</style>
</head>
<body data-theme="aptryk" data-density="default">

<div class="gate">
  <h1>Aptryk CRM is a desktop app.</h1>
  <p>Three panes, nothing behind an overlay, the list and the record visible at once. It does not fold down into a phone layout, on purpose.</p>
  <p>Open it on a display at least 1100px wide.</p>
</div>

<div class="app" id="app">

  <header class="bar">
    <button class="rail-btn tip" data-tip="Toggle sidebar" aria-label="Toggle sidebar"
      id="railBtn" onclick="App.rail()">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16" stroke-width="1.8"/><rect id="railFill" x="3.9" y="4.9" width="4.2" height="14.2" rx="1.2" fill="currentColor" stroke="none" opacity=".9"/></svg>
    </button>
    <div class="brand">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 1.8 22.2 12 12 22.2 1.8 12 12 1.8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M12 7.5 16.5 12 12 16.5 7.5 12 12 7.5Z" fill="currentColor"/></svg>
      <b>APTRYK</b>
    </div>
    <div class="bar-gap"></div>
    <div class="bar-end">
      <button class="btn btn-quiet search-btn" onclick="Palette.open()" aria-label="Search everything">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        Search <kbd>&#8984;K</kbd>
      </button>
      <button class="btn" id="syncBtn" onclick="Sync.pull(true)" title="Sync with the server">
        <span class="sync-w" id="syncTxt">Synced</span>
      </button>
      <button class="btn btn-primary" id="newBtn" onclick="App.create()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
        <span id="newTxt">New</span>
      </button>
    </div>
  </header>

  <nav class="nav" id="nav"></nav>

  <section class="main">
    <div class="head" id="head"></div>
    <div class="tools" id="tools"></div>
    <div class="cols" id="cols"></div>
    <div class="rows" id="rows"></div>
    <div class="sum" id="sum"></div>
    <div class="page" id="page" hidden></div>
  </section>

  <aside class="side" id="side">
    <div class="grip" id="grip" title="Drag to resize"></div>
    <div id="sideIn" style="display:flex;flex-direction:column;height:100%"></div>
  </aside>

  <footer class="foot">
    <span id="footL"></span><span class="foot-gap"></span><span id="footR"></span>
  </footer>
</div>

<div class="float-layer">
  <div class="menu" id="menu"></div>

  <div class="scrim" id="paletteWrap" onclick="if(event.target===this)Palette.close()">
    <div class="palette">
      <div class="palette-i">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input id="paletteIn" placeholder="Search accounts, projects, people &mdash; or jump to a view" autocomplete="off" spellcheck="false"/>
      </div>
      <div class="palette-r" id="paletteRes"></div>
    </div>
  </div>

  <div class="scrim mid" id="dialogWrap" onclick="if(event.target===this)Dialog.done(false)">
    <div class="dialog">
      <h3 id="dialogT">Are you sure?</h3>
      <p id="dialogM"></p>
      <div class="dialog-a">
        <button class="btn" onclick="Dialog.done(false)">Cancel</button>
        <button class="btn btn-alert" id="dialogOk" onclick="Dialog.done(true)">Delete</button>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"><span id="toastM"></span><button id="toastA" hidden></button></div>
</div>
<script>
/* ══════════════════════════════════════════════════════════════════════
   APTRYK CRM — internal CRM for a software + consulting team
   Desktop client. Mobile is a separate application by design.
   ══════════════════════════════════════════════════════════════════════ */

const $ = s => document.querySelector(s);
const uid = () => Math.random().toString(36).slice(2, 9);
const now = () => Date.now();
const DAY = 86400000;
const esc = s => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;')
  .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const initials = n => String(n||'').trim().split(/\s+/).slice(0,2)
  .map(w => w[0]||'').join('').toUpperCase() || '—';
const num = v => { const n = parseFloat(String(v ?? '').replace(/[^0-9.\-]/g,''));
  return isFinite(n) ? n : 0 };
const money = v => '$' + Math.round(num(v)).toLocaleString('en-US');
const short = v => { const n = num(v);
  return Math.abs(n) >= 1e6 ? '$' + (n/1e6).toFixed(1) + 'M'
    : Math.abs(n) >= 1000 ? '$' + Math.round(n/1000) + 'k' : '$' + Math.round(n) };
const days = t => Math.floor((now() - (t||0)) / DAY);
const ago = t => {
  if (t == null || !isFinite(t)) return '—';
  const s = Math.max(0, (now() - t) / 1000);
  if (s < 3600) return Math.max(1, ~~(s/60)) + 'm';
  if (s < 86400) return ~~(s/3600) + 'h';
  if (s < 604800) return ~~(s/86400) + 'd';
  if (s < 2592000) return ~~(s/604800) + 'w';
  return new Date(t).toLocaleDateString('en',{month:'short',day:'numeric'});
};
const onDate = t => (t==null||!isFinite(t)) ? '—'
  : new Date(t).toLocaleDateString('en',{month:'short',day:'numeric'});
const dateVal = t => { if (t==null||!isFinite(t)) return '';
  const d = new Date(t - new Date(t).getTimezoneOffset()*60000);
  return d.toISOString().slice(0,10) };
const debounce = (fn,ms) => { let h; return (...a)=>{clearTimeout(h);h=setTimeout(()=>fn(...a),ms)} };

/* ─── DOMAIN ─────────────────────────────────────────────────────── */
/* ─── THE LIFECYCLE ──────────────────────────────────────────────────
   A sales CRM models deals moving toward a close. Aptryk solves problems
   and builds systems, so "closed won" is the wrong terminal state: a
   system you ship does not end, it RUNS. Four states, and every one is a
   verb describing what the team is doing right now.

     SHAPE  — the problem is not yet understood. Scoping, proposing.
     BUILD  — we are making it.
     RUN    — it is live and we are operating or maintaining it.
     CLOSED — finished, cancelled or handed over.

   Run is the state a standard pipeline has no word for, and it is where
   retainers, subscriptions and every maintained system actually live. */
const STAGES = ['planning','building','running','done'];
const STAGE_T = { planning:'Planning', building:'Building', running:'Running', done:'Done' };
const STAGE_WHY = {
  planning:'Working out what to build and what it costs',
  building:'Being made right now',
  running:'Live — we keep it working',
  done:'Finished or stopped',
};
const LIVE = new Set(['planning','building','running']);

/* A signal is anything that might become work — inbound, a referral, or a
   problem we noticed ourselves. Warmth, not a sales stage. */
const LEADS = ['new','warm','ready'];
const LEAD_T = { new:'New', warm:'Warm', ready:'Ready' };

/* Aptryk builds its own products as well as client work, so work carries a
   KIND. House work has no org and is not billable, but can still earn. */
const KINDS = ['client','internal'];
const KIND_T = { client:'Client work', internal:'Our own' };

/* How it earns. Once, or every month. */
const CADENCE = ['none','weekly','monthly','quarterly'];
const CADENCE_T = { none:'No check-ins', weekly:'Weekly', monthly:'Monthly', quarterly:'Quarterly' };
const CADENCE_DAYS = { weekly:7, monthly:30, quarterly:91 };

const TYPES = ['once','monthly'];
const TYPE_T = { once:'One-off', monthly:'Monthly' };
const RECUR = new Set(['monthly']);
const STALE = 14, QUIET = 30, RENEW_IN = 45;

/* ─── STATE ──────────────────────────────────────────────────────── */
const KEY = 'aptryk:crm';
const BLANK = { clients:[], engagements:[], leads:[], reminders:[], captures:[],
  money:{proposals:[],invoices:[]}, activity:[], team:[], meId:null };
let S = structuredClone(BLANK);

function load() {
  let p = null;
  try { p = JSON.parse(localStorage.getItem(KEY) || 'null') } catch(e) {}
  S = { ...structuredClone(BLANK), ...(p||{}),
        money:{ ...BLANK.money, ...((p&&p.money)||{}) } };
  for (const k of ['clients','engagements','leads','reminders','captures','activity','team'])
    if (!Array.isArray(S[k])) S[k] = [];
  for (const k of ['proposals','invoices']) if (!Array.isArray(S.money[k])) S.money[k] = [];
  migrate();
  if (!S.team.length) S.team.push({ id:uid(), name:'You', email:'' });
  if (!S.meId || !S.team.find(m=>m.id===S.meId)) S.meId = S.team[0].id;
}

/* Additive and idempotent: existing records load untouched and gain
   defaults, so an older client keeps working against the same data. */
function migrate() {
  const stamp = o => { if (o.updatedAt==null) o.updatedAt = o.createdAt ?? o.t ?? now();
    if (o.createdAt==null) o.createdAt = o.t ?? o.updatedAt; return o };
  [S.clients,S.engagements,S.leads,S.reminders,S.captures,
   S.money.proposals,S.money.invoices].forEach(l => l.forEach(stamp));
  S.activity.forEach(a => { if (a.t==null) a.t = a.createdAt ?? now() });
  S.clients.forEach(c => {
    c.contacts = Array.isArray(c.contacts) ? c.contacts : [];
    c.tags = Array.isArray(c.tags) ? c.tags : [];
    if (c.owner === undefined) c.owner = null;
    if (c.industry === undefined) c.industry = '';
    if (!c.contacts.length && (c.email||c.phone))
      c.contacts.push({ id:uid(), name:c.name||'', role:'', email:c.email||'', phone:c.phone||'' });
  });
  S.engagements.forEach(e => {
    e.tasks = Array.isArray(e.tasks) ? e.tasks : [];
    e.links = Array.isArray(e.links) ? e.links : [];
    // Old vocabulary maps forward. A shipped one-off is Closed; a shipped
    // retainer or subscription is Running, which is the whole point of the
    // new state — the old model had nowhere to put it.
    const OLD_TYPE = { project:'once', retainer:'monthly', subscription:'monthly' };
    if (OLD_TYPE[e.type]) e.type = OLD_TYPE[e.type];
    if (!TYPES.includes(e.type)) e.type = 'once';
    const OLD_STAGE = { inbound:'planning', discovery:'planning', proposal:'planning',
      active:'building', shape:'planning', build:'building', run:'running', closed:'done' };
    if (OLD_STAGE[e.stage]) e.stage = OLD_STAGE[e.stage];
    if (e.stage === 'shipped') e.stage = RECUR.has(e.type) ? 'running' : 'done';
    if (!STAGES.includes(e.stage)) e.stage = 'building';
    if (e.kind === 'house') e.kind = 'internal';
    if (!KINDS.includes(e.kind)) e.kind = 'client';
    if (e.lead === undefined) e.lead = null;
    if (e.mrr === undefined) e.mrr = '';
    if (e.renewalAt === undefined) e.renewalAt = null;
    if (!CADENCE.includes(e.cadence)) e.cadence = 'none';
    if (e.checkedAt === undefined) e.checkedAt = null;
    if (!e.clientId && e.client) {
      const nm = String(e.client).trim();
      let a = S.clients.find(c => c.name.toLowerCase() === nm.toLowerCase());
      if (!a && nm) { a = { id:uid(), name:nm, industry:'', tags:[], contacts:[], owner:null,
        notes:'', createdAt:e.createdAt||now(), updatedAt:now() }; S.clients.push(a) }
      if (a) e.clientId = a.id;
    }
  });
  S.leads.forEach(l => {
    const OLD = { qualified:'ready', open:'new' };
    if (OLD[l.stage]) l.stage = OLD[l.stage];
    if (!LEADS.includes(l.stage)) l.stage = 'new';
    if (l.owner===undefined) l.owner=null;
  });
}

/* ─── IDENTITY ─────────────────────────────────────────────────────────
   Behind Cloudflare Access, the signed-in identity is exposed at
   /cdn-cgi/access/get-identity. Reading it turns "pick yourself from a
   roster" — an honour system — into real attribution: the log records who
   actually did something rather than who claimed to.

   It fails soft on purpose. Opened from a file, or from a URL not behind
   Access, the fetch fails and the roster picker stays exactly as it was. */
const Identity = {
  resolved: null,
  async claim() {
    let who = null;
    // No origin, no identity service. Asking anyway logs a network error.
    if (!/^https?:$/.test(location.protocol)) return;
    try {
      const res = await fetch('/cdn-cgi/access/get-identity', { credentials: 'include' });
      if (res.ok) {
        const j = await res.json();
        const email = (j.email || '').trim();
        if (email) who = { email, name: (j.name || '').trim() || email.split('@')[0] };
      }
    } catch (e) { /* not behind Access — the roster stays in charge */ }
    if (!who) return;
    this.resolved = who;
    // Adopt an existing roster entry rather than duplicating a person.
    let m = S.team.find(x => (x.email || '').toLowerCase() === who.email.toLowerCase())
         || S.team.find(x => (x.name || '').toLowerCase() === who.name.toLowerCase());
    if (!m) { m = { id: uid(), name: who.name, email: who.email }; S.team.push(m) }
    else if (!m.email) m.email = who.email;
    // The placeholder created on first run is not a person.
    S.team = S.team.filter(x => x.id === m.id || x.name !== 'You' || x.email);
    S.meId = m.id;
    saveLocal();
    if (typeof App !== 'undefined' && App.render) App.render();
  },
};

const saveLocal = () => { try { localStorage.setItem(KEY, JSON.stringify(S)) } catch(e){} };
const save = () => { saveLocal(); Sync.push() };

const acct = id => S.clients.find(c=>c.id===id) || null;
const mem = id => S.team.find(m=>m.id===id) || null;
const memName = id => (mem(id)||{}).name || '';
const projOf = id => S.engagements.filter(e=>e.clientId===id);
const openOf = id => projOf(id).filter(e=>LIVE.has(e.stage));
const acctName = e => (acct(e.clientId)||{}).name || '';
const openVal = e => LIVE.has(e.stage) ? num(e.budget) : 0;
const acctVal = id => openOf(id).reduce((s,e)=>s+openVal(e),0);
const acctMrr = id => projOf(id).filter(e=>RECUR.has(e.type)&&LIVE.has(e.stage))
  .reduce((s,e)=>s+num(e.mrr),0);
/* Running systems are allowed to be quiet — that is what running means.
   Only Shape and Build going silent is a problem. */
const stalled = e => (e.stage==='planning'||e.stage==='building') && days(e.updatedAt) >= STALE;
const quiet = c => days(c.updatedAt) >= QUIET && !openOf(c.id).length;
const eod = () => { const d=new Date(); d.setHours(23,59,59,999); return d.getTime() };
const late = r => !r.done && r.due && r.due < now();
const dueToday = r => !r.done && r.due && r.due >= now() && r.due <= eod();
const renewing = e => RECUR.has(e.type) && e.renewalAt && LIVE.has(e.stage)
  && e.renewalAt - now() < RENEW_IN*DAY;

/* A running system with a cadence is overdue a look when more days have
   passed than the cadence allows. Never checked counts as overdue — that
   is the point of committing to a cadence. */
const checkDue = e => e.stage === 'running' && e.cadence && e.cadence !== 'none'
  && days(e.checkedAt ?? e.updatedAt) >= CADENCE_DAYS[e.cadence];
const checkIn = (e, note) => {
  e.checkedAt = now(); e.updatedAt = now();
  log(`Checked in on <b>${esc(e.name || 'work')}</b>${note ? ' — ' + esc(note) : ''}`, e.id);
  save();
};

/* ─── LOG + UNDO ───────────────────────────────────────────────────────
   The log records what happened; a record you cannot act on is just a
   receipt. Every logged action carries a `rev` describing how to reverse
   it, so the Log becomes the undo history for the whole workspace.

   rev = { c: collection path, id, before: record|null, at: index }
     before === null  →  it was created, so undo deletes it
     before === {...} →  it was changed or deleted, so undo restores it

   Only LOGGED actions are reversible, which is the right scope: typing in
   a notes field should not fill the history, and it does not. */
const COLL = {
  clients: () => S.clients, engagements: () => S.engagements, leads: () => S.leads,
  reminders: () => S.reminders, captures: () => S.captures, activity: () => S.activity,
  proposals: () => S.money.proposals, invoices: () => S.money.invoices,
};

const risksFor = id => {
  const out = [];
  const jobs = projOf(id);
  if (days(acct(id) ? acct(id).updatedAt : 0) >= QUIET)
    out.push({ k:'quiet', t:'Not heard from in ' + days(acct(id).updatedAt) + ' days',
               to:['clients', id] });
  const stuck = jobs.filter(stalled);
  if (stuck.length)
    out.push({ k:'stuck', t:stuck.length + ' job' + (stuck.length>1?'s':'') + ' stuck',
               to:['work', stuck[0].id] });
  const late = jobs.filter(checkDue);
  if (late.length)
    out.push({ k:'check', t:late.length + ' overdue a check-in', to:['work', late[0].id] });
  const name = acct(id) ? (acct(id).name || '') : '';
  const unpaid = S.money.invoices.filter(i => i.status === 'overdue'
    && (i.client || '').toLowerCase() === name.toLowerCase());
  if (unpaid.length)
    out.push({ k:'unpaid', t:unpaid.length + ' unpaid invoice' + (unpaid.length>1?'s':''),
               to:['money', unpaid[0].id] });
  const noOwner = acct(id) && !acct(id).owner && jobs.length;
  if (noOwner) out.push({ k:'owner', t:'Nobody owns this client', to:['clients', id] });
  return out;
};
/* One signal is normal business. Two at once is a client you are losing. */
const AT_RISK = 2;
const atRisk = c => risksFor(c.id).length >= AT_RISK;

function log(label, refId, rev) {
  S.activity.unshift({ id:uid(), label, refId:refId||null, who:S.meId, t:now(),
                       rev: rev || null });
  if (S.activity.length > 300) S.activity.length = 300;
}

const Undo = {
  can: a => !!(a && a.rev && !a.rev.used && COLL[a.rev.c]),
  run(id) {
    const a = S.activity.find(x => x.id === id);
    if (!this.can(a)) return;
    const list = COLL[a.rev.c]();
    const cur = list.findIndex(o => o.id === a.rev.id);
    if (a.rev.before === null) {
      // it was created — remove it again
      if (cur !== -1) list.splice(cur, 1);
    } else if (cur !== -1) {
      // it was changed — put the old values back
      list[cur] = { ...structuredClone(a.rev.before), updatedAt: now() };
    } else {
      // it was deleted — put it back where it was
      list.splice(Math.min(a.rev.at ?? 0, list.length), 0,
                  { ...structuredClone(a.rev.before), updatedAt: now() });
    }
    a.rev.used = true;
    log('Undid: ' + a.label, a.rev.id);
    save();
    if (typeof App !== 'undefined') App.render();
    if (typeof toast === 'function') toast('Undone');
  },
};

/* ─── SYNC ───────────────────────────────────────────────────────────
   Unchanged wire contract: same worker, same endpoints, same table and
   column names, so this runs beside older clients on the same data.
   fromRow() is the inverse of row(); without it the pull path wrote
   snake_case straight into state, which detached every project from its
   account and made remote changes lose every merge. */
const API = {
  /* Same-origin path behind Cloudflare Access. Because it is relative, the
     browser sends the Access session cookie with every request and no
     secret needs to live in this file. */
  url: '/api',
  /* Only used in legacy cross-origin mode. Leave empty once `url` is a
     path — an unused secret in a shipped file is still a leaked secret. */
  key: '',
};

const Sync = {
  base: API.url + '/crm', key: API.key,
  /* Same-origin means Access is the gate and the cookie is the credential. */
  sameOrigin: API.url.startsWith('/'),
  shadow: {}, queue: [], busy: false, back: 1500, state: 'idle',
  extendedFields: false,   /* flip once D1 has the new columns */

  on() {
    const served = /^https?:$/.test(location.protocol);
    if (this.sameOrigin) return served;      // relative URL needs an origin
    return !!this.key && !this.key.includes('PASTE');
  },
  /* Send credentials the way this deployment expects, and never send a
     bearer token to an origin that does not need one. */
  head(extra) {
    const h = Object.assign({}, extra || {});
    if (!this.sameOrigin && this.key) h['Authorization'] = 'Bearer ' + this.key;
    return h;
  },
  fetchOpts(o) {
    return Object.assign({ credentials: this.sameOrigin ? 'include' : 'omit' }, o || {});
  },
  badge(s) {
    this.state = s;
    const txt = $('#syncTxt');
    if (!txt) return;
    txt.className = 'sync-w' + (s==='fail'?' bad':s==='ok'?' ok':'');
    txt.textContent = s==='ok'?'Synced':s==='busy'?'Syncing':s==='fail'?'Offline':'Local';
  },
  row(t, o) {
    const m = {
      clients: () => ({ id:o.id, name:o.name, company:o.company||'',
        email:(o.contacts||[])[0]?.email||'', phone:(o.contacts||[])[0]?.phone||'',
        tags:o.tags||[], notes:o.notes||'' }),
      engagements: () => ({ id:o.id, name:o.name, client_id:o.clientId||null,
        stage:o.stage, budget:o.budget||'', notes:o.notes||'',
        tasks:o.tasks||[], links:o.links||[] }),
      reminders: () => ({ id:o.id, text:o.text, due:o.due??null, done:o.done?1:0 }),
      captures:  () => ({ id:o.id, text:o.text, done:o.done?1:0 }),
      activity:  () => ({ id:o.id, label:o.label, ref_id:o.refId||null, t:o.t??now() }),
    }[t];
    if (!m) return null;
    const r = m();
    if (t !== 'activity') { r.created_at = o.createdAt ?? now();
      r.updated_at = o.updatedAt ?? r.created_at }
    if (this.extendedFields) {
      if (t==='clients') { r.owner=o.owner||null; r.contacts=o.contacts||[] }
      if (t==='engagements') { r.type=o.type; r.lead=o.lead||null;
        r.mrr=o.mrr||''; r.renewal_at=o.renewalAt??null }
    }
    return r;
  },
  moneyRow(kind, o) { return { id:o.id, kind, name:o.name, client:o.client||'',
    amount:o.amount||'', status:o.status||'draft',
    created_at:o.createdAt??now(), updated_at:o.updatedAt??now() } },

  fromRow(t, r) {
    if (!r || typeof r !== 'object') return null;
    if (r.updatedAt !== undefined || r.createdAt !== undefined) return r;
    const j = (v,f) => { if (v==null) return f; if (typeof v!=='string') return v;
      try { return JSON.parse(v) ?? f } catch(e) { return f } };
    const created = r.created_at ?? r.t ?? now();
    const o = { ...r, createdAt:created, updatedAt:r.updated_at ?? created };
    delete o.created_at; delete o.updated_at;
    if (t==='clients') { o.tags=j(r.tags,[]); o.contacts=j(r.contacts,[]);
      if (!o.contacts.length && (r.email||r.phone))
        o.contacts=[{id:uid(),name:r.name||'',role:'',email:r.email||'',phone:r.phone||''}];
      if (o.owner===undefined) o.owner=null; if (o.industry===undefined) o.industry='' }
    if (t==='engagements') { o.clientId=r.client_id??null; delete o.client_id;
      o.tasks=j(r.tasks,[]); o.links=j(r.links,[]);
      o.type=TYPES.includes(r.type)?r.type:'once'; o.lead=r.lead??null;
      o.kind=KINDS.includes(r.kind)?r.kind:(o.clientId?'client':'client');
      if (!STAGES.includes(o.stage)) {
        const OLD={inbound:'planning',discovery:'planning',proposal:'planning',
          active:'building',shape:'planning',build:'building',run:'running',closed:'done'};
        o.stage = OLD[o.stage] || (o.stage==='shipped'
          ? (RECUR.has(o.type)?'running':'done') : 'building');
      }
      o.mrr=r.mrr??''; o.renewalAt=r.renewal_at??null; delete o.renewal_at }
    if (t==='reminders') { o.done=!!r.done; o.due=r.due??null }
    if (t==='captures') { o.done=!!r.done; o.t=created }
    if (t==='activity') { o.refId=r.ref_id??null; delete o.ref_id; o.t=r.t??created }
    return o;
  },
  stampOf: o => o.updatedAt ?? o.createdAt ?? o.t ?? 0,

  collect() {
    const out = [], seen = new Set();
    const take = (t,o,b) => { const k=t+':'+o.id; seen.add(k);
      const st = Sync.stampOf(o);
      if (Sync.shadow[k] !== st) { out.push({table:t,op:'upsert',row:b()}); Sync.shadow[k]=st } };
    S.clients.forEach(o=>take('clients',o,()=>Sync.row('clients',o)));
    S.engagements.forEach(o=>take('engagements',o,()=>Sync.row('engagements',o)));
    S.reminders.forEach(o=>take('reminders',o,()=>Sync.row('reminders',o)));
    S.captures.forEach(o=>take('captures',o,()=>Sync.row('captures',o)));
    S.money.proposals.forEach(o=>take('money',o,()=>Sync.moneyRow('proposals',o)));
    S.money.invoices.forEach(o=>take('money',o,()=>Sync.moneyRow('invoices',o)));
    S.activity.forEach(a=>{ const k='activity:'+a.id; seen.add(k);
      if (Sync.shadow[k]===undefined) { out.push({table:'activity',op:'upsert',row:Sync.row('activity',a)});
        Sync.shadow[k]=a.t } });
    for (const k of Object.keys(Sync.shadow)) {
      if (seen.has(k)) continue;
      const [t,id] = k.split(':');
      out.push({ table:t, op:'delete', row:{id} }); delete Sync.shadow[k];
    }
    return out;
  },

  async push() {
    if (!this.on()) { this.badge('idle'); return }
    const m = this.collect(); if (m.length) this.queue.push(...m);
    if (this.busy || !this.queue.length) return;
    this.busy = true; this.badge('busy');
    const batch = this.queue.splice(0);
    try {
      const res = await fetch(this.base+'/mutate', this.fetchOpts({ method:'POST',
        headers: this.head({ 'Content-Type':'application/json' }),
        body: JSON.stringify({ mutations: batch }) }));
      if (!res.ok) throw new Error(res.status);
      this.back = 1500; this.badge('ok');
    } catch(e) {
      this.queue.unshift(...batch);            // never lose a mutation
      this.back = Math.min(this.back*2, 30000); this.badge('fail');
    } finally {
      this.busy = false;
      if (this.queue.length) setTimeout(()=>this.push(), this.back);
    }
  },

  pulling: false,
  async pull(manual) {
    if (!this.on() || this.pulling) return;
    this.pulling = true; if (manual) this.badge('busy');
    try {
      const res = await fetch(this.base+'/state', this.fetchOpts({ headers: this.head() }));
      if (!res.ok) throw new Error(res.status);
      if (this.merge(await res.json())) { saveLocal(); App.render() }
      this.badge('ok');
      if (manual) toast('Up to date');
    } catch(e) { this.badge('fail'); if (manual) toast('Could not reach the server — working locally') }
    finally { this.pulling = false }
  },

  merge(remote) {
    let changed = false;
    const ml = (local, incoming, table) => {
      const by = new Map(local.map(o=>[o.id,o]));
      (incoming||[]).forEach(raw => {
        const o = Sync.fromRow(table, raw);
        if (!o || !o.id) return;
        const cur = by.get(o.id);
        if (!cur || Sync.stampOf(o) > Sync.stampOf(cur)) { by.set(o.id,o); changed = true }
      });
      local.forEach(o => { const k = table+':'+o.id;
        if (!(incoming||[]).some(r=>r.id===o.id) && Sync.shadow[k]!==undefined) {
          by.delete(o.id); changed = true } });
      const out = [...by.values()];
      out.forEach(o => Sync.shadow[table+':'+o.id] = Sync.stampOf(o));
      return out;
    };
    S.clients = ml(S.clients, remote.clients, 'clients');
    S.engagements = ml(S.engagements, remote.engagements, 'engagements');
    S.reminders = ml(S.reminders, remote.reminders, 'reminders');
    S.captures = ml(S.captures, remote.captures, 'captures');
    // money arrives flat with a kind column, or grouped. Accept both rather
    // than silently dropping every invoice.
    const rm = remote.money, flat = Array.isArray(rm) ? rm : null;
    S.money.proposals = ml(S.money.proposals,
      flat ? flat.filter(m=>m.kind==='proposals') : (rm&&rm.proposals), 'money');
    S.money.invoices = ml(S.money.invoices,
      flat ? flat.filter(m=>m.kind==='invoices') : (rm&&rm.invoices), 'money');
    const seen = new Set(S.activity.map(a=>a.id));
    (remote.activity||[]).forEach(raw => {
      const a = Sync.fromRow('activity', raw);
      if (!a || !a.id || seen.has(a.id)) return;
      S.activity.push(a); seen.add(a.id); Sync.shadow['activity:'+a.id]=a.t; changed=true;
    });
    S.activity.sort((a,b)=>(b.t||0)-(a.t||0));
    if (S.activity.length > 300) S.activity.length = 300;
    return changed;
  },

  seed() {
    const m = (t,l) => l.forEach(o => Sync.shadow[t+':'+o.id] = Sync.stampOf(o));
    m('clients',S.clients); m('engagements',S.engagements); m('reminders',S.reminders);
    m('captures',S.captures); m('money',S.money.proposals); m('money',S.money.invoices);
    S.activity.forEach(a => Sync.shadow['activity:'+a.id] = a.t);
  },
  start() {
    if (!this.on()) { this.badge('idle'); return }
    this.pull();
    setInterval(()=>{ if(!document.hidden) this.pull() }, 45000);
    addEventListener('focus', ()=>this.pull());
  },
};

