  onclick="App.select(null)">${I.x}</button>`;

const Side = {
  set(id,k,v){ App.patch(anyRec(id), {[k]:v}) },
  setDate(id,k,v){ const t = v ? new Date(v+'T12:00:00').getTime() : null;
    this.set(id,k, isFinite(t)?t:null) },
