/* ─── THE TRACK ──────────────────────────────────────────────────────
   One designed idiom for every state in the app, replacing the coloured
   dots. A dot names a category; a track shows WHERE something sits in its
   life and how far it has left — the same information plus the thing you
   actually wanted to know. Learn it once, read it everywhere: work
   lifecycle (4 steps), signal warmth (3), money (3). */
function track(steps, at, label, tone){
  const i = steps.indexOf(at);
  const g = steps.map((_,n) => `<i class="${n < i ? 'was' : n === i ? 'is' : ''}"></i>`).join('');
  return `<span class="track ${tone||''}" title="${esc(label)}">
    <span class="track-g">${g}</span><span class="track-t">${esc(label)}</span></span>`;
}
const stageTrack = e => track(STAGES, e.stage, STAGE_T[e.stage],
  e.stage === 'closed' ? 'done' : stalled(e) ? 'warn' : '');
const signalTrack = l => track(LEADS, l.stage, LEAD_T[l.stage],
  l.stage === 'ready' ? 'done' : '');
const PAY_STEPS = ['draft','sent','paid'];
const PAY_AT = { draft:'draft', sent:'sent', overdue:'sent', paid:'paid',
                 accepted:'paid', declined:'draft' };
const PAY_T  = { draft:'Draft', sent:'Sent', overdue:'Unpaid', paid:'Paid',
                 accepted:'Accepted', declined:'Declined' };
const payTrack = m => track(PAY_STEPS, PAY_AT[m.status] || 'draft', PAY_T[m.status] || 'Draft',
  m.status === 'overdue' ? 'warn' : (m.status === 'paid' || m.status === 'declined') ? 'done' : '');

